  <script>
  (function(){
    const TEAL='#14b8a6', SLATE='#aab8c8', NAVY='#1a1a2e', GRID='#f1f5f9', MUTED='#94a3b8';
    const fmtN = v => Number(Math.round(v)).toLocaleString('es-CO');

    /* ── LEFT: value events area chart (últimos 7 meses, 90d rolling) ── */
    const funnelHist = {{ metrics.gtm.value_events | tojson | safe }};
    // 3 bands bottom→top, cumulative thresholds, fill:'-1'
    // Bookkeeping+ (asiento+) / Invoicing only / Not yet active
    const funnelBands = [
      { cum: d=>d.asiento, label:'Bookkeeping +',   color:TEAL,      bg:'rgba(20,184,166,0.80)',  lightText:true  },
      { cum: d=>d.factura, label:'Invoicing only',  color:SLATE,     bg:'rgba(170,184,200,0.78)', lightText:false },
      { cum: d=>100,       label:'Not yet active',  color:'#dde5ef', bg:'rgba(221,229,239,0.60)', lightText:false }
    ];
    const areaChart = new Chart(document.getElementById('s4c_area'), {
      type: 'line',
      data: {
        labels: funnelHist.map(r => r.m),
        datasets: funnelBands.map((b,i) => ({
          label: b.label,
          data: funnelHist.map(r => b.cum(r)),
          borderColor: b.color,
          backgroundColor: b.bg,
          borderWidth: 1,
          pointRadius: 0,
          tension: 0.3,
          fill: i === 0 ? 'origin' : '-1'
        }))
      },
      options: {
        responsive: true, maintainAspectRatio: false, animation: false,
        plugins: {
          legend: { display: false },
          tooltip: {
            mode: 'index', intersect: false,
            backgroundColor: '#fff', borderColor: 'rgba(0,0,0,.1)', borderWidth: 1,
            titleColor: '#111', bodyColor: '#555', titleFont:{size:9}, bodyFont:{size:9}, padding:6,
            filter: item => item.datasetIndex < 3,
            callbacks: {
              label: c => {
                const prev = c.datasetIndex === 0 ? 0 : areaChart.data.datasets[c.datasetIndex-1].data[c.dataIndex];
                return '  '+c.dataset.label+': '+(c.raw-prev).toFixed(1)+'%';
              }
            }
          }
        },
        scales: {
          x: { grid:{display:false}, border:{display:false}, ticks:{font:{size:8.5},color:MUTED,maxRotation:0} },
          y: { min:0, max:100, grid:{color:GRID}, border:{display:false},
               ticks:{font:{size:8.5},color:MUTED,callback:v=>v+'%',stepSize:20} }
        }
      },
      plugins: [{
        id:'bandLabels',
        afterDraw(chart) {
          const {ctx} = chart;
          funnelHist.forEach((row, xi) => {
            const xPx = chart.scales.x.getPixelForValue(xi);
            funnelBands.forEach((b, i) => {
              const cumVal = b.cum(row);
              const prevVal = i === 0 ? 0 : funnelBands[i-1].cum(row);
              const band = cumVal - prevVal;
              if (band < 6) return;
              const midY = chart.scales.y.getPixelForValue(prevVal + band/2);
              ctx.save();
              ctx.font = '600 7.5px Inter,sans-serif';
              ctx.fillStyle = b.lightText ? 'rgba(255,255,255,0.92)' : '#334155';
              ctx.textAlign = 'center';
              ctx.textBaseline = 'middle';
              ctx.fillText(band.toFixed(1)+'%', xPx, midY);
              ctx.restore();
            });
          });
        }
      }]
    });
    /* ── RIGHT: top-20 SoW table ── */
    const sow    = {{ metrics.gtm.supercontadores.sow     | tojson | safe }};
    const sowTot = {{ metrics.gtm.supercontadores.sow_tot | tojson | safe }};

    function fmtDelta(v) {
      if (v == null) return '<span style="color:#94a3b8">—</span>';
      const sign  = v > 0 ? '+' : '';
      const color = v > 0 ? '#16a34a' : v < 0 ? '#dc2626' : '#94a3b8';
      const arrow = v > 0 ? '↑ ' : v < 0 ? '↓ ' : '→ ';
      return `<span style="color:${color}">${arrow}${sign}${v.toFixed(1)}pp</span>`;
    }
    function sowBar(pct, color) {
      const w = Math.min(pct || 0, 100);
      return `<div style="display:flex;align-items:center;gap:5px;">
        <div style="flex:1;height:5px;background:#e2e8f0;border-radius:3px;overflow:hidden;">
