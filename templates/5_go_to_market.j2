    </tr></thead>`;

    const tbody = document.createElement('tbody');

    /* total row */
    const totTr = document.createElement('tr');
    totTr.style.cssText = 'border-bottom:2px solid #e2e8f0;background:#f8fafc;';
    totTr.innerHTML = `
      <td style="font-size:8.5px;font-weight:700;color:#334155;padding:3px 4px 3px 2px;">Total top 20</td>
