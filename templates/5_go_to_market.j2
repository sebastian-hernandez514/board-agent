  <script>
    /* ── Slide 2: New Logos charts ── */
    const months13 = {{ metrics.gtm.chart_months | tojson }};
    const tt = document.getElementById('tt');

    const coreD = {
      col: {{ metrics.gtm.new_logos_core_co | tojson }},
      mex: {{ metrics.gtm.new_logos_core_mx | tojson }},
      rd:  {{ metrics.gtm.new_logos_core_dr | tojson }},
      cr:  {{ metrics.gtm.new_logos_core_cr | tojson }}
    };
    const liteD = {
      col: {{ metrics.gtm.new_logos_lite_co | tojson }},
      mex: {{ metrics.gtm.new_logos_lite_mx | tojson }},
      rd:  {{ metrics.gtm.new_logos_lite_dr | tojson }},
      cr:  {{ metrics.gtm.new_logos_lite_cr | tojson }}
    };

    function extTT({ chart, tooltip }) {
      if (tooltip.opacity === 0) { tt.style.opacity = 0; return; }
      const r = chart.canvas.getBoundingClientRect();
      tt.style.left = (r.x + tooltip.caretX + 14) + 'px';
      tt.style.top  = (r.y + tooltip.caretY + window.scrollY - 10) + 'px';
      tt.style.opacity = 1;
      const i = tooltip.dataPoints[0].dataIndex;
      document.getElementById('tt-title').textContent = months13[i] + (i < 12 ? ' {{ config.year }}' : ' {{ config.year + 1 }}');
      const tot = tooltip.dataPoints.reduce((s, p) => s + p.raw, 0);
      document.getElementById('tt-body').innerHTML =
        tooltip.dataPoints.map(p =>
          `<div class="ttr"><span><span class="ttd" style="background:${p.dataset.backgroundColor}"></span>${p.dataset.label}</span><b>${p.raw.toLocaleString()}</b></div>`
        ).join('') +
        `<div class="ttr tttot"><span>Total</span><b>${tot.toLocaleString()}</b></div>`;
    }

    const nM = months13.length;
    let maxStacked = 0;
    for (let i = 0; i < nM; i++) {
      maxStacked = Math.max(maxStacked,
        (coreD.col[i]||0)+(coreD.mex[i]||0)+(coreD.rd[i]||0)+(coreD.cr[i]||0),
        (liteD.col[i]||0)+(liteD.mex[i]||0)+(liteD.rd[i]||0)+(liteD.cr[i]||0));
    }
    const sharedLogoMax = Math.ceil(maxStacked / 100) * 100 + 100;

    function mkChart(id, data, main, sec) {
      new Chart(document.getElementById(id), {
        type: 'bar',
        data: {
          labels: months13,
          datasets: [
            { label: 'Colombia',   data: data.col, backgroundColor: main,       stack: 's' },
            { label: 'México',     data: data.mex, backgroundColor: main + 'bb',stack: 's' },
            { label: 'Rep. Dom.',  data: data.rd,  backgroundColor: sec,        stack: 's' },
            { label: 'Costa Rica', data: data.cr,  backgroundColor: sec + 'bb', stack: 's' },
          ]
        },
        options: {
          responsive: true, maintainAspectRatio: false,
          plugins: {
            legend: {
              display: true, position: 'bottom',
              labels: { font: { size: 9, family: 'Inter' }, color: '#999', boxWidth: 8, boxHeight: 8, padding: 8 }
            },
            tooltip: { enabled: false, external: extTT }
          },
          scales: {
            x: { grid: { display: false }, ticks: { font: { size: 9, family: 'Inter' }, color: '#999', maxRotation: 0 }, border: { display: false } },
            y: { min: 0, max: sharedLogoMax, grid: { color: 'rgba(128,128,128,.07)' }, ticks: { font: { size: 9, family: 'Inter' }, color: '#999' }, border: { display: false } }
          }
        }
      });
    }

    mkChart('cCore', coreD, '#185FA5', '#E87722');
    mkChart('cLite', liteD, '#185FA5', '#E87722');
    document.addEventListener('mouseleave', () => { tt.style.opacity = 0; });

    /* ── Slide 3: Investment stacked bar charts (Core & Lite) ── */
    const acqMonths = {{ metrics.gtm.inv_chart_months | tojson }};
    const acqFmt = v => v >= 1000 ? '$' + (v/1000).toFixed(0) + 'K' : '$' + v;
    const acqOpts = (maxVal, minVal) => ({
      responsive: true,
      maintainAspectRatio: false,
      animation: false,
      plugins: {
        legend: { display: false },
        tooltip: {
          mode: 'index', intersect: false,
          backgroundColor: '#fff', borderColor: 'rgba(0,0,0,0.08)', borderWidth: 1,
          titleColor: '#141413', bodyColor: '#6b6a64',
          titleFont: { family: "'DM Mono',monospace", size: 9 },
          bodyFont:  { family: "'DM Mono',monospace", size: 10 },
          padding: 8,
          callbacks: { label: ctx => '  ' + ctx.dataset.label + ': ' + acqFmt(ctx.parsed.y) }
        }
      },
      scales: {
        x: {
          grid: { display: false },
          border: { display: false },
          ticks: { color: '#b4b2a9', font: { family: "'DM Mono',monospace", size: 9 },
                   maxRotation: 0, autoSkip: true, maxTicksLimit: 7 }
        },
        y: {
          grid: { color: 'rgba(0,0,0,0.05)', lineWidth: 0.5 },
          border: { display: false },
          ticks: { color: '#b4b2a9', font: { family: "'DM Mono',monospace", size: 9 },
                   callback: v => acqFmt(v), maxTicksLimit: 5 },
          min: minVal,
          max: maxVal
        }
      }
    });

    const acqDs = (label, data, color) => ({
      label, data,
      borderColor: color, backgroundColor: color.replace(')', ',0.08)').replace('rgb','rgba'),
      borderWidth: 2, tension: 0.4, pointRadius: 0, pointHoverRadius: 4, fill: false
    });

    const corePeople = {{ metrics.gtm.sm_core_people_series | tojson }};
    const corePaid   = {{ metrics.gtm.sm_core_paid_series   | tojson }};
    const coreOther  = {{ metrics.gtm.sm_core_other_series  | tojson }};
    const litePeople = {{ metrics.gtm.sm_lite_people_series | tojson }};
    const litePaid   = {{ metrics.gtm.sm_lite_paid_series   | tojson }};
    const liteOther  = {{ metrics.gtm.sm_lite_other_series  | tojson }};

    const allVals = [...corePeople, ...corePaid, ...coreOther, ...litePeople, ...litePaid, ...liteOther].filter(v => v != null);
    const sharedMax = Math.ceil(Math.max(...allVals) / 25000) * 25000 + 25000;
    const sharedMin = Math.max(0, Math.floor(Math.min(...allVals) / 25000) * 25000 - 25000);

    new Chart(document.getElementById('acqCoreChart'), {
      type: 'line',
      data: { labels: acqMonths, datasets: [
        acqDs('People',     corePeople, '#534AB7'),
        acqDs('Paid Media', corePaid,   '#C04828'),
        acqDs('Other',      coreOther,  '#a09e98'),
      ]},
      options: acqOpts(sharedMax, sharedMin)
    });

    new Chart(document.getElementById('acqLiteChart'), {
      type: 'line',
      data: { labels: acqMonths, datasets: [
        acqDs('People',     litePeople, '#534AB7'),
        acqDs('Paid Media', litePaid,   '#C04828'),
        acqDs('Other',      liteOther,  '#a09e98'),
      ]},
      options: acqOpts(sharedMax, sharedMin)
    });

    /* ── Slide 4: Conversion Sign up → Logo ── */
    const cvLabels = {{ metrics.gtm.funnel_countries.months | tojson | safe }};
    const CV_TEAL    = '#14b8a6';
    const CV_TEAL_BG = 'rgba(20,184,166,0.12)';
    const CV_NAVY    = 'rgba(51,65,85,0.35)';
    const CV_BLUE    = 'rgba(24,95,165,0.65)';

    function cvMakeChart(id, cvr, signups, logos) {
      new Chart(document.getElementById(id), {
        data: {
          labels: cvLabels,
          datasets: [
            { type: 'line', label: 'CVR %', data: cvr, yAxisID: 'yCVR',
              borderColor: CV_TEAL, backgroundColor: CV_TEAL_BG, fill: true,
              tension: 0.3, pointRadius: 3, pointBackgroundColor: CV_TEAL,
              borderWidth: 2, order: 1 },
            { type: 'bar', label: 'Sign ups', data: signups, yAxisID: 'ySU',
              backgroundColor: CV_NAVY, borderWidth: 0, order: 3 },
            { type: 'bar', label: 'New Logos', data: logos, yAxisID: 'yL',
              backgroundColor: CV_BLUE, borderWidth: 0, order: 2 }
          ]
        },
        options: {
          responsive: true, maintainAspectRatio: false, animation: false,
          interaction: { mode: 'index', intersect: false },
          plugins: {
            legend: { display: false },
            tooltip: { callbacks: { label: c => {
              if (c.dataset.label === 'CVR %') return 'CVR: ' + c.parsed.y.toFixed(1) + '%';
              return c.dataset.label + ': ' + c.parsed.y.toLocaleString('es-CO');
            }}}
          },
          scales: {
            x: { ticks: { font: { family: 'DM Mono', size: 9 }, color: '#64748b', maxRotation: 45, autoSkip: false },
                 grid: { display: false }, border: { color: '#e2e8f0' } },
            yCVR: { type: 'linear', position: 'left',
              ticks: { font: { family: 'DM Mono', size: 9 }, color: '#14b8a6', callback: v => v.toFixed(0) + '%' },
              grid: { color: '#e2e8f0', lineWidth: 0.5 }, border: { color: '#e2e8f0' } },
            ySU: { type: 'linear', position: 'right',
              ticks: { font: { family: 'DM Mono', size: 9 }, color: '#64748b',
                       callback: v => v >= 1000 ? (v/1000).toFixed(0) + 'K' : v },
              grid: { display: false }, border: { display: false } },
            yL: { type: 'linear', display: false }
          }
        }
      });
    }

    cvMakeChart('cvCol',
      {{ metrics.gtm.funnel_countries.colombia.cvr     | tojson | safe }},
      {{ metrics.gtm.funnel_countries.colombia.signups | tojson | safe }},
      {{ metrics.gtm.funnel_countries.colombia.logos   | tojson | safe }}
    );
    cvMakeChart('cvMex',
      {{ metrics.gtm.funnel_countries.mexico.cvr     | tojson | safe }},
      {{ metrics.gtm.funnel_countries.mexico.signups | tojson | safe }},
      {{ metrics.gtm.funnel_countries.mexico.logos   | tojson | safe }}
    );
    cvMakeChart('cvRd',
      {{ metrics.gtm.funnel_countries.republicaDominicana.cvr     | tojson | safe }},
      {{ metrics.gtm.funnel_countries.republicaDominicana.signups | tojson | safe }},
      {{ metrics.gtm.funnel_countries.republicaDominicana.logos   | tojson | safe }}
    );
    cvMakeChart('cvCr',
      {{ metrics.gtm.funnel_countries.costaRica.cvr     | tojson | safe }},
      {{ metrics.gtm.funnel_countries.costaRica.signups | tojson | safe }},
      {{ metrics.gtm.funnel_countries.costaRica.logos   | tojson | safe }}
    );

    /* ── (fml functions below kept for JS parsing, body replaced above) ──
    const fmlMo = [];
    const fmlCountries = [];

    const fmlFmt = n => n >= 1000 ? (n/1000).toFixed(1).replace(/\.0$/,'') + 'K' : String(n);
    const fmlSign = n => (n > 0 ? '+' : '') + n;

    function fmlDelta(cur, prev, isPct) {
      if (prev == null) return { txt: '—', cls: 'flat' };
      if (isPct) {
        const d = Math.round((cur - prev) * 10) / 10;
        return { txt: fmlSign(d) + 'pp vs mes ant.', cls: d > 0 ? 'up' : d < 0 ? 'down' : 'flat' };
      } else {
        const d = Math.round(((cur - prev) / prev) * 100);
        return { txt: fmlSign(d) + '% vs mes ant.', cls: d > 0 ? 'up' : d < 0 ? 'down' : 'flat' };
      }
    }

    function fmlBuildKPI(id, d) {
      const n = d.cvr.length;
      const avg = Math.round(d.cvr.reduce((a,b)=>a+b,0)/n*10)/10;
      const lastCVR = d.cvr[n-1], prevCVR = d.cvr[n-2];
      const lastSU  = d.signups[n-1] ?? d.signups[n-2], prevSU = d.signups[n-2];
      const lastL   = d.logos[n-1] ?? d.logos[n-2], prevL = d.logos[n-2];
      const dCVR = fmlDelta(lastCVR, prevCVR, true);
      const dSU  = fmlDelta(lastSU, prevSU, false);
      const dL   = fmlDelta(lastL, prevL, false);
      document.getElementById(id).innerHTML = `
        <div class="fml-kpi"><div class="fml-kpi-val cvr">${lastCVR}%</div><div class="fml-kpi-lbl">CVR último mes</div><div class="fml-kpi-delta ${dCVR.cls}">${dCVR.txt}</div></div>
        <div class="fml-kpi"><div class="fml-kpi-val cvr">${avg}%</div><div class="fml-kpi-lbl">CVR promedio</div><div class="fml-kpi-delta flat">período completo</div></div>
        <div class="fml-kpi"><div class="fml-kpi-val">${fmlFmt(lastSU)}</div><div class="fml-kpi-lbl">signups último mes</div><div class="fml-kpi-delta ${dSU.cls}">${dSU.txt}</div></div>
        <div class="fml-kpi"><div class="fml-kpi-val logo">${fmlFmt(lastL)}</div><div class="fml-kpi-lbl">logos último mes</div><div class="fml-kpi-delta ${dL.cls}">${dL.txt}</div></div>
      `;
    }

    function fmlBuildCVR(id, d) {
      const n = d.cvr.length;
      const avg = Math.round(d.cvr.reduce((a,b)=>a+b,0)/n*10)/10;
      const minI = d.cvr.indexOf(Math.min(...d.cvr));
      const maxI = d.cvr.indexOf(Math.max(...d.cvr));
      const show = [...new Set([0, n-1, minI, maxI])];
      const ptR  = d.cvr.map((_,i) => show.includes(i) ? 3 : 0);
      const ptBg = d.cvr.map((_,i) => show.includes(i) ? '#1a3d6e' : 'transparent');
      new Chart(document.getElementById(id), {
        type: 'line',
        data: {
          labels: fmlMo.slice(0,n),
          datasets: [
            { data: d.cvr, borderColor: '#1a3d6e', borderWidth: 2, tension: 0.35,
              pointRadius: ptR, pointBackgroundColor: ptBg, pointBorderColor: ptBg, pointBorderWidth: 2, fill: false },
            { data: Array(n).fill(avg), borderColor: 'rgba(0,0,0,0.15)', borderWidth: 1,
              borderDash: [5,3], pointRadius: 0, fill: false }
          ]
        },
        options: {
          responsive: true, maintainAspectRatio: false, animation: false,
          plugins: { legend: { display: false }, tooltip: { enabled: false } },
          scales: {
            x: { display: false },
            y: { grid: { color: fmlGridC, lineWidth: 0.5 }, border: { display: false },
                 ticks: { color: fmlTickC, font: { size: 9, family: fmlMono }, callback: v => v + '%', maxTicksLimit: 4 } }
          }
        },
        plugins: [{
          id: 'cvrLbl',
          afterDatasetsDraw(chart) {
            const { ctx, scales: { x, y } } = chart;
            ctx.save();
            ctx.font = `500 8.5px ${fmlMono}`;
            ctx.textAlign = 'center';
            ctx.fillStyle = '#1a3d6e';
            show.forEach(i => {
              const xp = x.getPixelForValue(i);
              const yp = y.getPixelForValue(d.cvr[i]);
              const off = (i === minI) ? 13 : -9;
              ctx.fillText(d.cvr[i] + '%', xp, yp + off);
            });
            ctx.restore();
          }
        }]
      });
    }

    function fmlBuildBars(id, d) {
      const n = Math.min(d.signups.length, d.logos.length);
      const logos = d.logos.slice(0, n);
      const su    = d.signups.slice(0, n);
      const nonC  = su.map((s,j) => Math.max(0, s - logos[j]));
      const midI  = Math.floor(n/2);
      const show  = [...new Set([0, midI, n-1])];
      new Chart(document.getElementById(id), {
        type: 'bar',
        data: {
          labels: fmlMo.slice(0,n),
          datasets: [
            { label: 'Logos',  data: logos, backgroundColor: 'rgba(29,158,117,0.65)', borderWidth: 0,
              borderRadius: { topLeft:0, topRight:0, bottomLeft:2, bottomRight:2 }, stack:'v' },
            { label: 'No conv.', data: nonC, backgroundColor: 'rgba(180,178,169,0.38)', borderWidth: 0,
              borderRadius: { topLeft:2, topRight:2, bottomLeft:0, bottomRight:0 }, stack:'v' }
          ]
        },
        options: {
          responsive: true, maintainAspectRatio: false, animation: false,
          plugins: { legend: { display: false }, tooltip: { enabled: false } },
          scales: {
            x: { stacked: true, grid: { display: false }, border: { display: false },
                 ticks: { color: fmlTickC, font: { size: 8.5, family: fmlMono }, maxRotation: 0 } },
            y: { stacked: true, display: false }
          }
        },
        plugins: [{
          id: 'barLbl',
          afterDatasetsDraw(chart) {
            const { ctx, scales: { x, y } } = chart;
            ctx.save();
            show.forEach(i => {
              const xp = x.getPixelForValue(i);
              const total = su[i];
              const logo  = logos[i];
              const topY  = y.getPixelForValue(total);
              ctx.textAlign = 'center';
              ctx.font = `400 8px ${fmlMono}`;
              ctx.fillStyle = '#888780';
              ctx.fillText(fmlFmt(total), xp, topY - 3);
            });
            ctx.restore();
          }
        }]
      });
    }

    // fmlCountries.forEach removed — slide 4 uses cvMakeChart instead
    */
  </script>

  <script>
  (function() {
    const months = {{ metrics.gtm.flywheel.months | tojson | safe }};

    const linePlugin = {
      id: 'fwLineLabels',
      afterDatasetsDraw(chart) {
        const { ctx } = chart;
        chart.data.datasets.forEach((ds, di) => {
          chart.getDatasetMeta(di).data.forEach((pt, i) => {
            const val = ds.data[i];
            if (val == null) return;
            ctx.save();
            ctx.font = 'bold 9px Segoe UI';
            ctx.fillStyle = ds.borderColor;
            ctx.textAlign = 'center';
            ctx.fillText(val, pt.x, pt.y + (di === 0 ? -10 : 12));
            ctx.restore();
          });
        });
      }
    };

    const barPlugin = {
      id: 'fwBarLabels',
      afterDatasetsDraw(chart) {
        const { ctx } = chart;
        chart.getDatasetMeta(0).data.forEach((bar, i) => {
          const val = chart.data.datasets[0].data[i];
          if (val == null) return;
          ctx.save();
          ctx.font = 'bold 8.5px Segoe UI';
          ctx.fillStyle = '#555';
          ctx.textAlign = 'center';
          ctx.fillText(val.toLocaleString(), bar.x, bar.y - 4);
          ctx.restore();
        });
      }
    };

    // Entities — desde RS (dwh_facts + db_hubspot)
    const entNewAdds = {{ metrics.gtm.flywheel.ent_new_adds | tojson | safe }};
    const entChurn   = {{ metrics.gtm.flywheel.ent_churn    | tojson | safe }};
    const entStock   = {{ metrics.gtm.flywheel.ent_stock    | tojson | safe }};

    if (document.getElementById('fw_entitiesLine')) new Chart(document.getElementById('fw_entitiesLine'), {
      type: 'line',
      data: {
        labels: months,
        datasets: [
          { label: 'New Adds', data: entNewAdds, borderColor: '#1a1a2e', backgroundColor: '#1a1a2e', borderWidth: 2, pointRadius: 4, tension: 0.1 },
          { label: 'Net Churn', data: entChurn, borderColor: '#c0392b', backgroundColor: '#c0392b', borderWidth: 2, pointRadius: 4, tension: 0.1 }
        ]
      },
      plugins: [linePlugin],
      options: {
        responsive: true, maintainAspectRatio: false, animation: false,
        plugins: { legend: { display: false } },
        scales: {
          x: { grid: { display: false }, ticks: { font: { size: 9 }, color: '#555', maxRotation: 0, callback: (v, i) => months[i].split('\n') } },
          y: { min: 0, max: 600, grid: { color: '#f0f0f0' }, ticks: { font: { size: 9 }, color: '#555', stepSize: 150 } }
        }
      }
    });

    if (document.getElementById('fw_entitiesBar')) new Chart(document.getElementById('fw_entitiesBar'), {
      type: 'bar',
      data: { labels: months, datasets: [{ data: entStock, backgroundColor: '#778899', borderRadius: 2, barPercentage: 0.85 }] },
      plugins: [barPlugin],
      options: {
        responsive: true, maintainAspectRatio: false, animation: false,
        plugins: { legend: { display: false } },
        scales: {
          x: { grid: { display: false }, ticks: { font: { size: 9 }, color: '#555', maxRotation: 0, callback: (v, i) => months[i].split('\n') } },
          y: { min: 0, max: 10000, grid: { color: '#f0f0f0' }, ticks: { font: { size: 9 }, color: '#555' } }
        }
      }
    });

    // Logos — desde RS (dwh_facts + db_hubspot)
    const lgNewAdds = {{ metrics.gtm.flywheel.lg_new_adds | tojson | safe }};
    const lgChurn   = {{ metrics.gtm.flywheel.lg_churn    | tojson | safe }};
    const lgStock   = {{ metrics.gtm.flywheel.lg_stock    | tojson | safe }};

    if (document.getElementById('fw_logosLine')) new Chart(document.getElementById('fw_logosLine'), {
      type: 'line',
      data: {
        labels: months,
        datasets: [
          { label: 'New Adds', data: lgNewAdds, borderColor: '#1a1a2e', backgroundColor: '#1a1a2e', borderWidth: 2, pointRadius: 4, tension: 0.1 },
          { label: 'Net Churn', data: lgChurn, borderColor: '#c0392b', backgroundColor: '#c0392b', borderWidth: 2, pointRadius: 4, tension: 0.1 }
        ]
      },
      plugins: [linePlugin],
      options: {
        responsive: true, maintainAspectRatio: false, animation: false,
        plugins: { legend: { display: false } },
        scales: {
          x: { grid: { display: false }, ticks: { font: { size: 9 }, color: '#555', maxRotation: 0, callback: (v, i) => months[i].split('\n') } },
          y: { min: 0, max: 1000, grid: { color: '#f0f0f0' }, ticks: { font: { size: 9 }, color: '#555', stepSize: 250 } }
        }
      }
    });

    if (document.getElementById('fw_logosBar')) new Chart(document.getElementById('fw_logosBar'), {
      type: 'bar',
      data: { labels: months, datasets: [{ data: lgStock, backgroundColor: '#778899', borderRadius: 2, barPercentage: 0.85 }] },
      plugins: [barPlugin],
      options: {
        responsive: true, maintainAspectRatio: false, animation: false,
        plugins: { legend: { display: false } },
        scales: {
          x: { grid: { display: false }, ticks: { font: { size: 9 }, color: '#555', maxRotation: 0, callback: (v, i) => months[i].split('\n') } },
          y: { min: 0, max: 16000, grid: { color: '#f0f0f0' }, ticks: { font: { size: 9 }, color: '#555' } }
        }
      }
    });

    // ── Slide 4b: Combined Flywheel Quarterly ──
    (function(){
      const qIdx    = {{ metrics.gtm.flywheel.q_idx | tojson | safe }};
      const qLabels = {{ metrics.gtm.flywheel.q_labels | tojson | safe }};
      const qFilter = arr => qIdx.map(i => (arr && arr[i] !== undefined) ? arr[i] : null);

      const entNewAddsQ = qFilter(entNewAdds);
      const entChurnQ   = qFilter(entChurn);
      const entStockQ   = qFilter(entStock);
      const lgNewAddsQ  = qFilter(lgNewAdds);
      const lgChurnQ    = qFilter(lgChurn);
      const lgStockQ    = qFilter(lgStock);

      // Stock Logos split: propia/eop ratio from supercontadores
      const ownRatio = {{ metrics.gtm.supercontadores.propia | default(0) }} / ({{ metrics.gtm.supercontadores.eop | default(1) }} || 1);
      const lgStockOwnQ = lgStockQ.map(v => v != null ? Math.round(v * ownRatio) : null);
      const lgStockCliQ = lgStockQ.map(v => v != null ? Math.round(v * (1 - ownRatio)) : null);

      const mkLineOpts = (maxY, step) => ({
        responsive: true, maintainAspectRatio: false, animation: false,
        plugins: { legend: { display: false },
          tooltip: { mode: 'index', intersect: false, backgroundColor: '#fff', borderColor: 'rgba(0,0,0,0.1)', borderWidth: 1, titleColor: '#111', bodyColor: '#555', titleFont: { size: 9 }, bodyFont: { size: 9 }, padding: 6 }
        },
        scales: {
          x: { grid: { display: false }, ticks: { font: { size: 8.5 }, color: '#777', maxRotation: 0 }, border: { display: false } },
          y: { min: 0, max: maxY, grid: { color: '#f0f0f0' }, ticks: { font: { size: 8.5 }, color: '#777', stepSize: step }, border: { display: false } }
        }
      });

      const mkBarOpts = (maxY, stacked) => ({
        responsive: true, maintainAspectRatio: false, animation: false,
        plugins: { legend: { display: false },
          tooltip: { mode: 'index', intersect: false, backgroundColor: '#fff', borderColor: 'rgba(0,0,0,0.1)', borderWidth: 1, titleColor: '#111', bodyColor: '#555', titleFont: { size: 9 }, bodyFont: { size: 9 }, padding: 6,
            callbacks: { label: ctx => ` ${ctx.dataset.label}: ${ctx.parsed.y.toLocaleString()}` }
          }
        },
        scales: {
          x: { grid: { display: false }, stacked: !!stacked, ticks: { font: { size: 8.5 }, color: '#777', maxRotation: 0 }, border: { display: false } },
          y: { min: 0, max: maxY, stacked: !!stacked, grid: { color: '#f0f0f0' }, ticks: { font: { size: 8.5 }, color: '#777' }, border: { display: false } }
        }
      });

      new Chart(document.getElementById('fw2_entLine'), {
        type: 'line',
        data: { labels: qLabels, datasets: [
          { label: 'New Adds',  data: entNewAddsQ, borderColor: '#1a1a2e', backgroundColor: '#1a1a2e', borderWidth: 2, pointRadius: 3, tension: 0.1 },
          { label: 'Net Churn', data: entChurnQ,   borderColor: '#c0392b', backgroundColor: '#c0392b', borderWidth: 2, pointRadius: 3, tension: 0.1 }
        ]},
        options: mkLineOpts(600, 150)
      });

      new Chart(document.getElementById('fw2_entBar'), {
        type: 'bar',
        data: { labels: qLabels, datasets: [{ label: 'Stock', data: entStockQ, backgroundColor: '#778899', borderRadius: 2, barPercentage: 0.8 }] },
        plugins: [barPlugin],
        options: mkBarOpts(10000, false)
      });

      new Chart(document.getElementById('fw2_lgLine'), {
        type: 'line',
        data: { labels: qLabels, datasets: [
          { label: 'New Adds',  data: lgNewAddsQ, borderColor: '#1a1a2e', backgroundColor: '#1a1a2e', borderWidth: 2, pointRadius: 3, tension: 0.1 },
          { label: 'Net Churn', data: lgChurnQ,   borderColor: '#c0392b', backgroundColor: '#c0392b', borderWidth: 2, pointRadius: 3, tension: 0.1 }
        ]},
        options: mkLineOpts(1000, 250)
      });

      new Chart(document.getElementById('fw2_lgBar'), {
        type: 'bar',
        data: { labels: qLabels, datasets: [
          { label: 'Own accounts', data: lgStockOwnQ, backgroundColor: '#aab8c8', borderRadius: 0, barPercentage: 0.8, stack: 'lg' },
          { label: 'Client logos',  data: lgStockCliQ, backgroundColor: '#1a1a2e', borderRadius: 2, barPercentage: 0.8, stack: 'lg' }
        ]},
        options: mkBarOpts(16000, true)
      });
    })();

  })();
  </script>

