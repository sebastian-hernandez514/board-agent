  <script>
const D=window.DATA;
const NAVY='#0f172b',TEAL='#14b8a6',SLATE='#94a3b8',ORANGE='#C2410C',GRID='#f1f5f9',MUTED='#94a3b8';
const fmtN=v=>Number(Math.round(v)).toLocaleString('es-CO');
const TIP={enabled:true,backgroundColor:NAVY,padding:12,titleFont:{size:12,weight:'600'},titleColor:'#fff',
  bodyFont:{size:11},bodyColor:'#fff',displayColors:true,boxPadding:4,cornerRadius:6,borderColor:'rgba(255,255,255,.1)',borderWidth:1};
Chart.defaults.font.family='Inter, sans-serif';

// chips / kpis
const pct=(a,b)=>Math.round(100*a/b)+'%';

k_eop.textContent=fmtN(D.eop); k_cli.textContent=fmtN(D.clientes); k_pro.textContent=fmtN(D.propia);
k_cli_pct.textContent=pct(D.clientes,D.eop); k_pro_pct.textContent=pct(D.propia,D.eop);
k_mrr.textContent='$'+fmtN(D.sow_tot.mrr); k_sow.textContent=D.sow_tot.sow_asoc+'%';
k_sow_d.textContent=fmtN(D.sow_tot.real); k_gap.textContent=fmtN(D.sow_tot.gap);

// ── Slide 2: histórico stacked bar · últimos 12 meses ──
(function(){
  const MES=['ene','feb','mar','abr','may','jun','jul','ago','sep','oct','nov','dic'];
  const lab=m=>MES[+m.slice(5,7)-1]+"'"+m.slice(2,4);
  const h=D.hist.slice(-12), labels=h.map(r=>lab(r.m));
  new Chart(histChart,{type:'bar',
    data:{labels,datasets:[
      {label:'Clients of accountant',data:h.map(r=>r.clientes),backgroundColor:TEAL,hoverBackgroundColor:'#0d9488',borderRadius:2,stack:'a',barPercentage:.82,categoryPercentage:.9},
      {label:'Own accounts',data:h.map(r=>r.propia),backgroundColor:SLATE,hoverBackgroundColor:'#64748b',borderRadius:2,stack:'a',barPercentage:.82,categoryPercentage:.9}
    ]},
    options:{responsive:true,maintainAspectRatio:false,layout:{padding:{top:6,right:4}},interaction:{mode:'index',intersect:false,axis:'x'},
      plugins:{legend:{display:true,position:'top',align:'end',labels:{font:{size:10},boxWidth:10,boxHeight:10,padding:10,color:'#64748b'}},
        tooltip:{...TIP,callbacks:{label:c=>'  '+c.dataset.label+': '+fmtN(c.raw),
          footer:i=>'  Total: '+fmtN(h[i[0].dataIndex].total)},footerFont:{size:11,weight:'600'},footerColor:TEAL,footerMarginTop:6}},
      scales:{y:{stacked:true,beginAtZero:true,grid:{color:GRID,drawBorder:false},border:{display:false},ticks:{callback:v=>fmtN(v),font:{size:10},color:MUTED,maxTicksLimit:6}},
        x:{stacked:true,grid:{display:false},border:{display:false},ticks:{font:{size:9.5},color:MUTED,maxRotation:0}}}}});
})();

// ── Slide 3: funnel hbars ──
(function(){
  const f=D.fc;
  const rows=[['Account · ≥1 value event',f.acct_ge1_pct,f.acct_ge1,'gray'],
              ['Accountant works the account',f.trabaja_pct,f.trabaja,'teal'],
              ['Accountant bookkeeps (attributable)',f.contabiliza_pct,f.contabiliza,'teal']];
  funnel.innerHTML=rows.map((r,i)=>`<div class="hbar-row${i==2?' em':''}"><div class="hbar-name">${r[0]}</div><div class="hbar-track"><div class="hbar-fill ${r[3]}" style="width:${r[1]}%"></div></div><div class="hbar-val">${r[1]}% · ${fmtN(r[2])}</div></div>`).join('');
  const e=D.fc.eventos, mx=Math.max(...e.map(x=>x.pct));
  events.innerHTML=e.map(x=>`<div class="hbar-row" style="grid-template-columns:140px 1fr 92px"><div class="hbar-name">${x.k.split(' (')[0]}</div><div class="hbar-track"><div class="hbar-fill ${x.attr?'teal':'gray'}" style="width:${Math.round(100*x.pct/mx)}%"></div></div><div class="hbar-val">${x.pct}% · ${fmtN(x.n)}</div></div>`).join('');
})();

// ── Slide 3: trend ──
(function(){
  const t=D.fc_hist.filter(r=>r.tracked);
  new Chart(fcTrend,{type:'line',data:{labels:t.map(r=>r.m.slice(2)),datasets:[
    {label:'% bookkeeps',data:t.map(r=>r.pct),borderColor:TEAL,backgroundColor:'rgba(20,184,166,.14)',borderWidth:2.5,pointRadius:3,pointHoverRadius:6,pointBackgroundColor:TEAL,pointBorderColor:'#fff',pointBorderWidth:1.5,tension:.3,fill:true}]},
    options:{responsive:true,maintainAspectRatio:false,layout:{padding:{top:6,right:4}},interaction:{mode:'index',intersect:false,axis:'x'},
      plugins:{legend:{display:false},tooltip:{...TIP,callbacks:{title:i=>i[0].label,label:c=>'  '+c.raw+'% · '+fmtN(t[c.dataIndex].contabiliza)+'/'+fmtN(t[c.dataIndex].clientes)+' PyMEs'}}},
      scales:{y:{beginAtZero:true,suggestedMax:12,grid:{color:GRID,drawBorder:false},border:{display:false},ticks:{callback:v=>v+'%',font:{size:10},color:MUTED,stepSize:3}},
        x:{grid:{display:false},border:{display:false},ticks:{font:{size:9.5},color:MUTED,maxRotation:0}}}}});
})();

// ── Slide 4: SoW stacked horizontal ──
(function(){
  const s=D.sow, short=n=>{n=n.replace(/\s*\(.*\)/,'').replace(/\s*-\s*.*/,'');return n.length>20?n.slice(0,19)+'…':n;};
  new Chart(sowChart,{type:'bar',data:{labels:s.map(r=>short(r.contador)),datasets:[
      {label:'Paying portfolio',data:s.map(r=>r.real),backgroundColor:TEAL,hoverBackgroundColor:'#0d9488',borderRadius:2,stack:'a',barPercentage:.9,categoryPercentage:.86},
      {label:'Gap to convert',data:s.map(r=>Math.max(0,r.asoc-r.real)),backgroundColor:'#e2e8f0',hoverBackgroundColor:SLATE,borderRadius:2,stack:'a',barPercentage:.9,categoryPercentage:.86}
    ]},
    options:{indexAxis:'y',responsive:true,maintainAspectRatio:false,layout:{padding:{top:4,right:8}},interaction:{mode:'index',intersect:false},
      plugins:{legend:{display:true,position:'top',align:'end',labels:{font:{size:10},boxWidth:10,boxHeight:10,padding:10,color:'#64748b'}},
        tooltip:{...TIP,callbacks:{label:c=>'  '+c.dataset.label+': '+fmtN(c.raw),
          footer:i=>{const r=s[i[0].dataIndex];return '  SoW '+r.sow_asoc+'% · MRR $'+fmtN(r.mrr)+' · '+r.pais;}},footerFont:{size:10,weight:'600'},footerColor:TEAL,footerMarginTop:6}},
      scales:{x:{stacked:true,beginAtZero:true,grid:{color:GRID,drawBorder:false},border:{display:false},ticks:{font:{size:9.5},color:MUTED,maxTicksLimit:6}},
        y:{stacked:true,grid:{display:false},border:{display:false},ticks:{font:{size:9},color:'#475569',autoSkip:false},afterFit:sc=>{sc.width=118;}}}}});
})();
</script>

