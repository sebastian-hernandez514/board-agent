      <td style="text-align:right;font-size:8px;padding:3px 4px;">${fmtDelta(sowTot.delta_mom)}</td>
      <td style="text-align:right;font-size:8px;padding:3px 2px 3px 4px;">${fmtDelta(sowTot.delta_yoy)}</td>`;
    tbody.appendChild(totTr);

    sow.forEach((r, i) => {
      const tr = document.createElement('tr');
      tr.style.cssText = 'border-bottom:1px solid #f1f5f9;' + (i % 2 === 1 ? 'background:#fafbfc;' : '');
      tr.innerHTML = `
        <td style="font-size:8px;font-weight:600;color:#334155;padding:2px 4px 2px 2px;max-width:130px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;">${r.contador}</td>
        <td style="padding:2px 8px 2px 4px;">${sowBar(r.sow_asoc, NAVY)}</td>
        <td style="text-align:right;font-size:8.5px;font-weight:600;color:#334155;padding:2px 4px;">${r.real}</td>
        <td style="text-align:right;font-size:8px;padding:2px 4px;">${fmtDelta(r.delta_mom)}</td>
        <td style="text-align:right;font-size:8px;padding:2px 2px 2px 4px;">${fmtDelta(r.delta_yoy)}</td>`;
      tbody.appendChild(tr);
    });

    tbl.appendChild(tbody);

  })();
  </script>

