(function(){
 const xs=INC.inc_med,ys=INC.net_up,mos=INC.mos,n=xs.length;
 const xmn=Math.min(...xs),xmx=Math.max(...xs),ymn=Math.min(...ys),ymx=Math.max(...ys);
 const W=390,H=195,mL=38,mR=12,mT=16,mB=28;const xr=[xmn-2,xmx+2],yr=[ymn-0.28,ymx+0.4];
 const X=v=>mL+(W-mL-mR)*(v-xr[0])/(xr[1]-xr[0]),Y=v=>mT+(H-mT-mB)*(1-(v-yr[0])/(yr[1]-yr[0]));
 const mx_=xs.reduce((a,b)=>a+b)/n,my=ys.reduce((a,b)=>a+b)/n;let sxy=0,sxx=0;for(let i=0;i<n;i++){sxy+=(xs[i]-mx_)*(ys[i]-my);sxx+=(xs[i]-mx_)**2;}
 const sl=sxy/sxx,ic=my-sl*mx_;
 let g='<svg viewBox="0 0 '+W+' '+H+'" style="width:100%;height:auto">';
 g+='<line x1="'+X(0)+'" y1="'+mT+'" x2="'+X(0)+'" y2="'+(H-mB)+'" stroke="#e7edf1"/><line x1="'+mL+'" y1="'+Y(0)+'" x2="'+(W-mR)+'" y2="'+Y(0)+'" stroke="#e7edf1"/>';
 g+='<line x1="'+X(xr[0]).toFixed(1)+'" y1="'+Y(ic+sl*xr[0]).toFixed(1)+'" x2="'+X(xr[1]).toFixed(1)+'" y2="'+Y(ic+sl*xr[1]).toFixed(1)+'" stroke="#0f2b45" stroke-width="1.6" stroke-dasharray="4 3"/>';
 for(let i=0;i<n;i++){const dec=mos[i].slice(5)=='12',jan=mos[i].slice(5)=='01';const c=dec?'#2f9e78':(jan?'#c96a80':'#9db4bf');
   g+='<circle cx="'+X(xs[i]).toFixed(1)+'" cy="'+Y(ys[i]).toFixed(1)+'" r="'+(dec||jan?4.5:3)+'" fill="'+c+'"/>';}
 g+='<circle cx="'+(mL+8)+'" cy="'+(mT+6)+'" r="4" fill="#2f9e78"/><text x="'+(mL+16)+'" y="'+(mT+9)+'" style="font-size:9px;font-weight:700;fill:#2f9e78">December</text>';
 g+='<circle cx="'+(mL+8)+'" cy="'+(mT+20)+'" r="4" fill="#c96a80"/><text x="'+(mL+16)+'" y="'+(mT+23)+'" style="font-size:9px;font-weight:700;fill:#c96a80">January</text>';
 g+='<text x="'+((mL+W-mR)/2)+'" y="'+(H-4)+'" text-anchor="middle" style="font-size:9px;fill:var(--dtexp-muted)">customer income change, month over month</text>';
 g+='<text x="12" y="'+((mT+H-mB)/2)+'" transform="rotate(-90 12 '+((mT+H-mB)/2)+')" text-anchor="middle" style="font-size:9px;fill:var(--dtexp-muted)">net upsell (% MRR)</text>';
 $('#dtexp-chart2').innerHTML=g;
})();
