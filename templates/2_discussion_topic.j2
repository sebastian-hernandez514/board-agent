const MN=['Jan','Feb','Mar','Apr','May','Jun','Jul','Aug','Sep','Oct','Nov','Dec'];
const fmtM=m=>MN[+m.slice(5,7)-1]+"'"+m.slice(2,4);
const MOND={upselling:MON.comp.upsell,downselling:MON.comp.downsell,cross_up:MON.comp.cross_up,cross_down_later:MON.comp.cross_down_later,initial_unwind:MON.comp.cross_down_t0,pricing:MON.comp.pricing};
MOND.net_upselling=add(MOND.upselling,MOND.downselling);MOND.crosselling=add(MOND.cross_up,MOND.cross_down_later);
MOND.net_expansion=add(add(add(MOND.net_upselling,MOND.crosselling),MOND.initial_unwind),MOND.pricing);
const MONP={};for(const k in MOND)MONP[k]=MOND[k].map((v,i)=>100*v/MON.bop[i]);
let CUR='net_expansion';
function sel(id){CUR=id;$('#dtexp-tbl').querySelectorAll('tr.dtexp-row').forEach(tr=>tr.classList.toggle('dtexp-sel',tr.dataset.id==id));draw();}
function draw(){
 const row=ROWS.find(r=>r.id==CUR),lines=row.lines,n=MON.mos.length;
 $('#dtexp-leg').innerHTML=lines.map(k=>'<span><i style="border-color:'+COL[k]+'"></i>'+LBL[k]+'</span>').join('')+'<span style="color:var(--dtexp-muted)">· monthly</span>';
 let all=[];lines.forEach(k=>all=all.concat(MONP[k]));
 let mx=Math.max(...all,0.5)*1.1,mn=Math.min(...all,-0.5)*1.12;
 const W=908,H=170,mL=40,mR=14,mT=10,mB=24;
 const y=v=>mT+(H-mT-mB)*(1-(v-mn)/(mx-mn)),step=(W-mL-mR)/(n-1),X=i=>mL+step*i;
 let g='<svg viewBox="0 0 '+W+' '+H+'" style="width:100%;height:auto">';
 for(let t=Math.ceil(mn);t<=Math.floor(mx);t++){g+='<line x1="'+mL+'" y1="'+y(t)+'" x2="'+(W-mR)+'" y2="'+y(t)+'" stroke="'+(t==0?'#c7d2d9':'#eef2f4')+'"/><text x="'+(mL-5)+'" y="'+(y(t)+3)+'" text-anchor="end" style="font-size:9px;fill:var(--dtexp-muted)">'+t+'%</text>';}
 lines.forEach(k=>{const a=MONP[k];const emph=(k==CUR||k=='net_'+CUR);
   g+='<path d="'+a.map((v,i)=>(i?'L':'M')+X(i).toFixed(1)+' '+y(v).toFixed(1)).join(' ')+'" fill="none" stroke="'+COL[k]+'" stroke-width="'+(emph?2.6:1.8)+'"'+(emph?'':' stroke-opacity="0.75"')+'/>';});
 MON.mos.forEach((m,i)=>{if(i%3==0||i==n-1)g+='<text x="'+X(i).toFixed(1)+'" y="'+(H-10)+'" text-anchor="middle" style="font-size:8.5px;fill:var(--dtexp-muted)">'+fmtM(m)+'</text>';});
 MON.mos.forEach((_,i)=>g+='<rect x="'+(X(i)-step/2).toFixed(1)+'" y="'+mT+'" width="'+step+'" height="'+(H-mT-mB)+'" fill="transparent" data-i="'+i+'"/>');
 g+='</svg>';$('#dtexp-chart').innerHTML=g;
 $('#dtexp-chart').querySelectorAll('rect[data-i]').forEach(r=>{r.onmousemove=e=>{const i=+r.dataset.i;
   let html='<b>'+fmtM(MON.mos[i])+' &middot; start MRR '+nf$(MON.bop[i])+'</b>';
   lines.forEach(k=>{html+='<div class="r"><span><i style="display:inline-block;width:9px;height:9px;border-radius:2px;background:'+COL[k]+';margin-right:5px"></i>'+LBL[k]+'</span><span class="v">'+nfp(MONP[k][i])+' <span style="color:#9fb2bd">'+nf$(MOND[k][i])+'</span></span></div>';});
   tipOn(e,html);};r.onmouseleave=tipOff;});
}
sel('net_expansion');
$('#dtexp-take1').innerHTML='<b>Durable net expansion collapsed from ~15% per semester (2H24) to 1.7% (1H26).</b> Net upsell turned <b>negative</b> in 1H26; genuine cross-sell is a real small positive (+~1%) but offset by a <b>growing initial-sale unwind</b> (−1%); and the tariff bump is fading. Nothing compounds.';
// ---- SLIDE 2 scatter ----
(function(){
 const xs=INC.inc_med,ys=INC.net_up,mos=INC.mos,n=xs.length;
 const xmn=Math.min(...xs),xmx=Math.max(...xs),ymn=Math.min(...ys),ymx=Math.max(...ys);
 const W=390,H=195,mL=38,mR=12,mT=16,mB=28;const xr=[xmn-2,xmx+2],yr=[ymn-0.28,ymx+0.4];
 const X=v=>mL+(W-mL-mR)*(v-xr[0])/(xr[1]-xr[0]),Y=v=>mT+(H-mT-mB)*(1-(v-yr[0])/(yr[1]-yr[0]));
 const mx_=xs.reduce((a,b)=>a+b)/n,my=ys.reduce((a,b)=>a+b)/n;let sxy=0,sxx=0;for(let i=0;i<n;i++){sxy+=(xs[i]-mx_)*(ys[i]-my);sxx+=(xs[i]-mx_)**2;}
 const sl=sxy/sxx,ic=my-sl*mx_;
 let g='<svg viewBox="0 0 '+W+' '+H+'" style="width:100%;height:auto">';
 g+='<line x1="'+X(0)+'" y1="'+mT+'" x2="'+X(0)+'" y2="'+(H-mB)+'" stroke="#e7edf1"/><line x1="'+mL+'" y1="'+Y(0)+'" x2="'+(W-mR)+'" y2="'+Y(0)+'" stroke="#e7edf1"/>';
 g+='<line x1="'+X(xr[0]).toFixed(1)+'" y1="'+Y(ic+sl*xr[0]).toFixed(1)+'" x2="'+X(xr[1]).toFixed(1)+'" y2="'+Y(ic+sl*xr[1]).toFixed(1)+'" stroke="#0f2b45" stroke-width="1.6" stroke-dasharray="4 3"/>';
 for(let i=0;i<n;i++){const dec=mos[i].slice(5)=='12',jan=mos[i].slice(5)=='01';const c=dec?'#2f9e78':(jan?'#c96a80':'#9db4bf');
   g+='<circle cx="'+X(xs[i]).toFixed(1)+'" cy="'+Y(ys[i]).toFixed(1)+'" r="'+(dec||jan?4.5:3)+'" fill="'+c+'"/>';}
 g+='<circle cx="'+(mL+8)+'" cy="'+(mT+6)+'" r="4" fill="#2f9e78"/><text x="'+(mL+16)+'" y="'+(mT+9)+'" style="font-size:9px;font-weight:700;fill:#2f9e78">December</text>';
 g+='<circle cx="'+(mL+8)+'" cy="'+(mT+20)+'" r="4" fill="#c96a80"/><text x="'+(mL+16)+'" y="'+(mT+23)+'" style="font-size:9px;font-weight:700;fill:#c96a80">January</text>';
 g+='<text x="'+((mL+W-mR)/2)+'" y="'+(H-4)+'" text-anchor="middle" style="font-size:9px;fill:var(--dtexp-muted)">customer income change, month over month</text>';
 g+='<text x="12" y="'+((mT+H-mB)/2)+'" transform="rotate(-90 12 '+((mT+H-mB)/2)+')" text-anchor="middle" style="font-size:9px;fill:var(--dtexp-muted)">net upsell (% MRR)</text>';
 $('#dtexp-chart2').innerHTML=g;
})();
})();
</script>

</body>
</html>
