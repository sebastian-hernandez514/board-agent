   lines.forEach(k=>{html+='<div class="r"><span><i style="display:inline-block;width:9px;height:9px;border-radius:2px;background:'+COL[k]+';margin-right:5px"></i>'+LBL[k]+'</span><span class="v">'+nfp(MONP[k][i])+' <span style="color:#9fb2bd">'+nf$(MOND[k][i])+'</span></span></div>';});
   tipOn(e,html);};r.onmouseleave=tipOff;});
}
function applyCountry(cc){CCUR=cc;SEM=BYC[cc].sem;MON=BYC[cc].mon;computeSem();computeMon();buildTable();draw();document.querySelectorAll('.dtexp-cbtn').forEach(b=>b.classList.toggle('dtexp-on',b.dataset.cc==cc));}
document.querySelectorAll('.dtexp-cbtn').forEach(b=>b.onclick=()=>applyCountry(b.dataset.cc));
applyCountry('ALL');
$('#dtexp-take1').innerHTML='<b>Most of the ~15%→~2% decline is deliberate: we eased off pricing, our strongest lever.</b> Genuine tariff drove ~+6–10% per semester through 1H25; we chose to raise less this year (~+2% in 1H26). The learning: the churn we feared from price increases does not necessarily stick, so we likely have <b>room to be more intentional</b> — a strategic call, not a miss. Easing it, though, exposed the real gap: upsell and cross-sell are not picking up the slack.';
