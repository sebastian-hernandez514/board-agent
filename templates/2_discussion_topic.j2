<!-- updated_for_month: 2026-10 -->
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Alegra Board — Discussion Topics</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=DM+Sans:wght@300;400;500;600&family=DM+Mono:wght@400;500&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="../styles/base.css">
  <style>
    /* ── Section cover ── */
    .section-divider {
      background: var(--color-navy);
      justify-content: center;
      padding: var(--slide-pad-y) var(--slide-pad-x);
    }
    .section-divider .eyebrow {
      font-size: 11px; font-weight: 600; color: var(--color-teal);
      letter-spacing: 2px; text-transform: uppercase; margin-bottom: 14px;
    }
    .section-divider .section-title {
      font-size: 38px; font-weight: 700; color: #ffffff;
      letter-spacing: -1.2px; line-height: 1.1; margin-bottom: 14px; max-width: 640px;
    }
    .section-divider .topic-label {
      font-size: 15px; font-weight: 400; color: rgba(255,255,255,0.40);
    }
    .section-divider .slide-num {
      position: absolute; bottom: 24px; right: var(--slide-pad-x);
      font-size: 10px; color: rgba(255,255,255,0.15);
    }
    /* ── Slides vacías pendientes de contenido ── */
    .dt-empty-body {
      flex: 1; display: flex; align-items: center; justify-content: center;
      color: #cbd5e1; font-size: 13px; font-style: italic;
    }
    /* ── Lista de candidatos a Discussion Topic (2026-10-21, Mayra Gutiérrez) ── */
    .dt-topic-list {
      flex: 1; display: flex; flex-direction: column; justify-content: center;
      gap: 14px; padding: 24px 56px;
    }
    .dt-topic-item { display: flex; gap: 14px; align-items: flex-start; }
    .dt-topic-num {
      flex-shrink: 0; width: 26px; height: 26px; border-radius: 50%;
      background: var(--color-navy); color: #fff; font-size: 12px; font-weight: 700;
      display: flex; align-items: center; justify-content: center;
      font-family: 'DM Mono', monospace;
    }
    .dt-topic-title { font-size: 13.5px; font-weight: 700; color: var(--color-text-primary); margin-bottom: 2px; }
    .dt-topic-desc { font-size: 11.5px; color: var(--color-text-secondary); line-height: 1.4; }
    /* ── "Pricing for Size" (2026-10-23) — 4 slides pegadas verbatim desde
       ~/Downloads/pricing-for-size-board.html (sin los <details class="notes">, pedido
       explícito del usuario). Diseño nativo 1920×1080 con todo posicionado absoluto;
       se escala 0.5 para calzar exacto en el slide de 960×540 del board (960×2=1920,
       540×2=1080, escala exacta sin recorte). Los resets de box-sizing/body/márgenes de p,h2,h3
       del archivo original no se copiaron porque base.css ya los aplica globalmente. */
    .ps-slide .frame { position: relative; width: 960px; height: 540px; overflow: hidden; }
    .ps-slide .frame > section {
      position: absolute; top: 0; left: 0; width: 1920px; height: 1080px;
      overflow: hidden; transform-origin: top left; transform: scale(0.5);
    }
  </style>
</head>
<body>

  <!-- ================================================================
       DISCUSSION TOPIC — vaciado de nuevo 2026-11-17 para octubre (pedido del usuario: solo cover + 2 slides vacías). Contenido de septiembre (candidatos + 4 slides 'Pricing for Size') en boards/2026-09/ v77. Reseteo anterior 2026-10-21 (pedido explícito del
       usuario): el tema de septiembre todavía no está definido, así que
       esta sección queda con el cover genérico + 2 slides vacías, sin
       ninguna referencia a NDR. El contenido de NDR (NDR by Market, How
       NDR Has Evolved, NDR Global, FX Effect) que vivía acá hasta v11 se
       quitó por completo de este template — si hace falta recuperarlo,
       está en el historial de versiones de boards/2026-09/ (v2 a v11).
       ================================================================ -->
  <div class="slide section-divider">
    <div class="eyebrow">Board Discussion</div>
    <div class="section-title">Discussion Topic</div>
    <div class="topic-label">{{ config.month_label }}</div>
  </div>


  <div class="slide-divider">↓ &nbsp; 1 / 2</div>

  <div class="slide">
    <div class="slide-header">
      <span class="title">Discussion Topic</span>
      <span class="period">{{ config.month_label }}</span>
    </div>
    <div class="dt-empty-body">—</div>
    <div class="slide-footer">
      <span class="footer-page">1/2</span>
    </div>
  </div>

  <div class="slide-divider">↓ &nbsp; 2 / 2</div>

  <div class="slide">
    <div class="slide-header">
      <span class="title">Discussion Topic</span>
      <span class="period">{{ config.month_label }}</span>
    </div>
    <div class="dt-empty-body">—</div>
    <div class="slide-footer">
      <span class="footer-page">2/2</span>
    </div>
  </div>

</body>
</html>
