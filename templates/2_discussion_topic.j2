<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Alegra Board — Discussion Topics</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=DM+Sans:wght@300;400;500;600&family=DM+Mono:wght@400;500&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="../styles/base.css">
  <style>
    /* ── Section cover ── */
    .section-divider {
      background: var(--color-navy);
      justify-content: center;
      padding: var(--slide-pad-y) var(--slide-pad-x);
    }
    .section-divider .eyebrow {
      font-size: 11px; font-weight: 600; color: var(--color-teal);
      letter-spacing: 2px; text-transform: uppercase; margin-bottom: 14px;
    }
    .section-divider .section-title {
      font-size: 38px; font-weight: 700; color: #ffffff;
      letter-spacing: -1.2px; line-height: 1.1; margin-bottom: 14px; max-width: 640px;
    }
    .section-divider .topic-label {
      font-size: 15px; font-weight: 400; color: rgba(255,255,255,0.40);
    }
    .section-divider .slide-num {
      position: absolute; bottom: 24px; right: var(--slide-pad-x);
      font-size: 10px; color: rgba(255,255,255,0.15);
    }

    /* ── Shared slide shell ── */
    .dt-slide {
      width: var(--slide-width);
      height: var(--slide-height);
      background: #fff;
      border-radius: 10px;
      box-shadow: 0 4px 24px rgba(0,0,0,0.10);
      display: flex;
      flex-direction: column;
      flex-shrink: 0;
      overflow: hidden;
    }
    .dt-body {
      flex: 1;
      padding: 18px 28px 14px;
      display: flex;
      flex-direction: column;
      gap: 8px;
      min-height: 0;
      overflow: hidden;
    }
    .dt-subtitle {
      font-size: 12px;
      color: var(--color-text-secondary);
      margin-top: -4px;
    }
    .dt-subtitle strong { color: var(--color-text-primary); font-weight: 600; }

    /* ── Field Insights ── */
    .insights-list {
      flex: 1;
      display: flex;
      flex-direction: column;
      gap: 7px;
      min-height: 0;
      overflow: hidden;
    }
    .insight-row {
      display: flex;
      align-items: flex-start;
      gap: 14px;
      padding: 10px 16px;
      background: var(--color-surface);
      border: 1px solid var(--color-border);
      border-radius: 10px;
      flex: 1;
      min-height: 0;
    }
    .insight-num {
      min-width: 26px; height: 26px;
      border-radius: 50%;
      background: var(--color-teal-light);
      border: 1.5px solid rgba(20,184,166,0.25);
      display: flex; align-items: center; justify-content: center;
      font-size: 12px; font-weight: 700; color: var(--color-teal);
      flex-shrink: 0; margin-top: 1px;
    }
    .insight-content { flex: 1; display: flex; flex-direction: column; gap: 3px; }
    .insight-title {
      font-size: 13px; font-weight: 700;
      color: var(--color-text-primary); line-height: 1.3;
    }
    .insight-desc {
      font-size: 11.5px; color: var(--color-text-secondary); line-height: 1.45;
    }
    .insight-hl {
      font-size: 11px; font-weight: 500;
      color: var(--color-teal); line-height: 1.4;
      margin-top: 1px; padding-left: 8px;
      border-left: 2px solid var(--color-teal);
    }

    /* ── Pricing Strategy ── */
    .pricing-cols {
      flex: 1;
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 20px;
      min-height: 0;
      overflow: hidden;
    }
    .left-col {
      display: flex; flex-direction: column; gap: 8px; min-height: 0;
    }
    .col-label {
      font-size: 9px; font-weight: 700; letter-spacing: 0.1em;
      text-transform: uppercase; color: var(--color-text-secondary);
    }
    .moves-list {
      display: flex; flex-direction: column; gap: 6px;
      flex: 1; min-height: 0; overflow: hidden;
    }
    .move-item {
      display: flex; align-items: flex-start; gap: 10px;
      padding: 8px 12px;
      background: var(--color-surface);
      border: 1px solid var(--color-border);
      border-radius: 8px;
    }
    .move-num {
      min-width: 22px; height: 22px; border-radius: 5px;
      background: var(--color-teal-light);
      border: 1px solid rgba(20,184,166,0.2);
      display: flex; align-items: center; justify-content: center;
      font-size: 11px; font-weight: 700; color: var(--color-teal);
      flex-shrink: 0; margin-top: 1px;
    }
    .move-text { flex: 1; display: flex; flex-direction: column; gap: 1px; }
    .move-title { font-size: 12px; font-weight: 700; color: var(--color-text-primary); line-height: 1.3; }
    .move-desc { font-size: 11px; color: var(--color-text-secondary); line-height: 1.35; }
    .move-desc .accent { color: var(--color-teal); font-weight: 600; }
    .bottom-boxes {
      display: grid; grid-template-columns: 1fr 1fr; gap: 8px; flex-shrink: 0;
    }
    .info-box {
      padding: 10px 12px; border-radius: 8px;
      border: 1px solid var(--color-border);
      display: flex; flex-direction: column; gap: 4px;
    }
    .info-box.neutral { background: var(--color-surface); }
    .info-box.accent  { background: var(--color-teal-light); border-color: rgba(20,184,166,0.2); }
    .info-box .box-label {
      font-size: 8.5px; font-weight: 700; letter-spacing: 0.08em;
      text-transform: uppercase; color: var(--color-text-secondary);
    }
    .info-box.accent .box-label { color: #0f766e; }
    .info-box .box-title { font-size: 11px; font-weight: 700; color: var(--color-text-primary); line-height: 1.3; }
    .info-box .box-desc { font-size: 10.5px; color: var(--color-text-secondary); line-height: 1.35; }
    .info-box .box-desc strong { color: var(--color-text-primary); font-weight: 600; }

    /* ── Browser mockup ── */
    .right-col { display: flex; flex-direction: column; min-height: 0; }
    .browser-wrap {
      flex: 1;
      background: #fff;
      border: 1px solid var(--color-border);
      border-radius: 10px;
      display: flex; flex-direction: column;
      overflow: hidden;
      box-shadow: 0 2px 12px rgba(0,0,0,0.06);
    }
    .browser-bar {
      display: flex; align-items: center; gap: 6px;
      padding: 6px 10px;
      background: var(--color-surface);
      border-bottom: 1px solid var(--color-border);
    }
    .b-dots { display: flex; gap: 4px; }
    .b-dot { width: 6px; height: 6px; border-radius: 50%; background: var(--color-border); }
    .b-url {
      flex: 1; font-size: 9.5px; color: var(--color-text-secondary);
      background: #fff; border: 1px solid var(--color-border);
      border-radius: 4px; padding: 2px 8px; margin-left: 4px;
    }
    .mockup-body {
      flex: 1; padding: 14px 16px;
      display: flex; flex-direction: column; gap: 10px; overflow: hidden;
    }
    .m-title { font-size: 15px; font-weight: 700; color: var(--color-text-primary); }
    .m-sub { font-size: 10.5px; color: var(--color-text-secondary); margin-top: -6px; }
    .m-tabs { display: flex; gap: 4px; }
    .m-tab {
      font-size: 10px; font-weight: 600; padding: 4px 10px;
      border-radius: 5px; background: var(--color-surface);
      color: var(--color-text-secondary); border: 1px solid var(--color-border);
    }
    .m-tab.active { background: var(--color-navy); color: #fff; border-color: var(--color-navy); }
    .plans-row {
      display: grid; grid-template-columns: repeat(4,1fr); gap: 8px;
      flex: 1; min-height: 0;
    }
    .plan-card {
      border: 1px solid var(--color-border); border-radius: 8px;
      padding: 10px 8px; display: flex; flex-direction: column; gap: 6px;
      background: #fff;
    }
    .plan-card.rec {
      border-color: var(--color-teal);
      box-shadow: 0 0 0 1.5px var(--color-teal);
    }
    .plan-badge {
      font-size: 7.5px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.05em;
      color: #fff; background: var(--color-teal);
      padding: 2px 6px; border-radius: 10px; width: fit-content;
    }
    .plan-name { font-size: 11px; font-weight: 600; color: var(--color-text-primary); }
    .plan-rfc {
      font-size: 9px; font-weight: 500; color: var(--color-teal);
      background: var(--color-teal-light); padding: 2px 6px;
      border-radius: 4px; width: fit-content;
    }
    .plan-price {
      font-size: 19px; font-weight: 800; color: var(--color-text-primary);
      margin-top: auto; display: flex; align-items: baseline; gap: 2px;
    }
    .plan-price span { font-size: 10px; font-weight: 500; color: var(--color-text-secondary); }
    .plan-price.custom { font-size: 15px; }
    .plan-check {
      font-size: 9.5px; color: var(--color-text-secondary);
      display: flex; align-items: center; gap: 4px;
    }
    .plan-check::before { content: '✓'; color: var(--color-teal); font-weight: 700; font-size: 10px; }
    .m-note {
      font-size: 10px; color: var(--color-text-secondary);
      display: flex; align-items: center; gap: 6px;
      padding: 6px 8px; background: var(--color-surface);
      border-radius: 6px; border: 1px solid var(--color-border);
    }
    .m-banner {
      font-size: 10px; font-weight: 600;
      color: #5b21b6; background: #ede9fe;
      padding: 7px 10px; border-radius: 6px;
      display: flex; align-items: center; gap: 6px;
    }
    .m-footer {
      font-size: 9px; color: var(--color-text-secondary); text-align: center; margin-top: 2px;
    }
    .m-footer a { color: var(--color-teal); font-weight: 600; text-decoration: none; }

    /* ── Costa Rica ICP slides ── */
    .icp-img-stage {
      flex: 1; min-height: 0; display: flex; align-items: center; justify-content: center;
      background: var(--color-surface); border: 1px solid var(--color-border);
      border-radius: 12px; padding: 16px; overflow: hidden;
    }
    .icp-img-stage img { max-width: 100%; max-height: 100%; object-fit: contain; border-radius: 8px;
      box-shadow: 0 6px 24px rgba(15,23,42,0.10); border: 1px solid var(--color-border); }
    .icp-chip-row { display: flex; gap: 10px; margin-top: 12px; flex-shrink: 0; }
    .icp-chip {
      flex: 1; background: var(--color-teal-light); border: 1px solid rgba(20,184,166,0.18);
      border-radius: 10px; padding: 10px 14px;
    }
    .icp-chip .c-tag { font-size: 10px; font-weight: 700; letter-spacing: 0.08em; text-transform: uppercase; color: #0f766e; }
    .icp-chip .c-txt { font-size: 11.5px; color: var(--color-text-secondary); font-weight: 500; margin-top: 3px; line-height: 1.35; }
    .icp-chip .c-txt b { color: var(--color-text-primary); font-weight: 700; }

    /* ── CR Result slide ── */
    .cr-body { flex: 1; min-height: 0; display: flex; gap: 14px; }
    .cr-chart {
      flex: 0 0 56%; display: flex; flex-direction: column;
      background: var(--color-surface); border: 1px solid var(--color-border);
      border-radius: 12px; padding: 14px 16px; overflow: hidden; gap: 6px;
    }
    .cr-chart .chart-label { font-size: 12px; font-weight: 700; color: var(--color-text-primary); }
    .cr-chart .chart-label span { color: var(--color-text-secondary); font-weight: 500; font-size: 11px; }
    .cr-chart .cr-svg { flex: 1; min-height: 0; width: 100%; }
    .cr-chart .chart-note { font-size: 10px; color: var(--color-text-secondary); flex-shrink: 0; }
    .cr-funnel { flex: 1; display: flex; flex-direction: column; gap: 10px; justify-content: center; min-width: 0; }
    .ft-block { display: flex; flex-direction: column; gap: 5px; }
    .ft-cap {
      font-size: 10px; font-weight: 700; letter-spacing: 0.08em; text-transform: uppercase;
      color: #0f766e; display: flex; align-items: center; gap: 6px;
    }
    .ft-cap::before { content: ''; width: 5px; height: 5px; border-radius: 50%; background: var(--color-teal); flex-shrink: 0; }
    .cr-ft {
      width: 100%; border-collapse: collapse; font-size: 11px;
      background: var(--color-surface); border: 1px solid var(--color-border); border-radius: 10px; overflow: hidden;
    }
    .cr-ft thead th {
      background: var(--color-navy); color: #fff;
      font-size: 9.5px; font-weight: 700; letter-spacing: 0.04em;
      padding: 6px 10px; text-align: right; white-space: nowrap;
    }
    .cr-ft thead th:first-child { text-align: left; }
    .cr-ft tbody tr { border-top: 1px solid var(--color-border); }
    .cr-ft tbody td { padding: 5px 10px; text-align: right; color: var(--color-text-secondary); font-weight: 600; white-space: nowrap; }
    .cr-ft tbody td:first-child { text-align: left; color: var(--color-text-primary); font-weight: 600; }
    .cr-ft tbody td.post { color: var(--color-text-primary); font-weight: 700; }
    .cr-ft .pos { color: #0f766e; font-weight: 800; }
    .cr-ft .neg { color: var(--color-text-secondary); font-weight: 600; }
    .cr-ft tr.total td { background: var(--color-teal-light); border-top: 1.5px solid rgba(20,184,166,0.3); }
    .cr-ft tr.total td:first-child { color: #0f766e; font-weight: 800; }
    .cr-ft tr.cr-hero td { background: rgba(20,184,166,0.07); }
    .cr-ft tr.cr-hero td:first-child { color: #0f766e; font-weight: 800; }
    .ft-note { font-size: 9.5px; color: var(--color-text-secondary); font-style: italic; line-height: 1.4; }
  </style>
  <style>
  /* ── Discussion Topic: Mexico Update + Growth Ambition & Brand Investment (2026-07-27) ── */

:root{
  --navy:#0f172b; --bg:#ffffff; --surface:#f8fafc; --border:#e2e8f0;
  --teal:#14b8a6; --teal-l:#f0fdfa; --pos:#16a34a; --neg:#C2410C;
  --neu:#64748b; --tp:#0f172b; --ts:#64748b; --amber:#d97706;
  --sw:960px; --sh:540px; --px:40px;
}
*,*::before,*::after{box-sizing:border-box;margin:0;padding:0}
body{font-family:'Inter',system-ui,sans-serif;background:#dde3ea;color:var(--tp);
  display:flex;flex-direction:column;align-items:center;gap:22px;padding:40px 20px;min-height:100vh;-webkit-font-smoothing:antialiased}

.dtmx-slide{width:var(--sw);height:var(--sh);background:var(--bg);border-radius:10px;overflow:hidden;
  box-shadow:0 6px 28px rgba(15,23,43,.12);display:flex;flex-direction:column;flex-shrink:0;position:relative}
.dtmx-divider{width:var(--sw);text-align:center;font-size:11px;color:#9ca3af;letter-spacing:1px;user-select:none}

/* header */
.dtmx-sh{background:var(--navy);padding:13px var(--px);display:flex;align-items:center;justify-content:space-between;gap:16px;flex-shrink:0}
.dtmx-sh .dtmx-title{color:#fff;font-size:15px;font-weight:600;font-family:'DM Sans',sans-serif;line-height:1.25;max-width:720px}
.dtmx-sh .dtmx-right{display:flex;align-items:center;gap:14px;flex-shrink:0}
.dtmx-sh .dtmx-period{color:var(--teal);font-size:11px;font-weight:500;white-space:nowrap}
.dtmx-sh .dtmx-num{font-family:'DM Mono',monospace;font-size:10px;color:rgba(255,255,255,.35);white-space:nowrap}

/* footer */
.dtmx-sf{background:var(--surface);border-top:1px solid var(--border);padding:8px var(--px);
  display:flex;justify-content:space-between;align-items:center;flex-shrink:0}
.dtmx-sf span{font-size:10px;color:var(--neu);font-family:'DM Sans',sans-serif}

/* body */
.dtmx-sb{flex:1;padding:18px var(--px) 12px;display:flex;flex-direction:column;gap:12px;min-height:0;overflow:hidden}

/* section cover */
.dtmx-cover{background:var(--navy);justify-content:center;align-items:flex-start;padding:0 72px}
.dtmx-cover .dtmx-eyebrow{font-size:13px;font-weight:700;color:var(--teal);letter-spacing:4px;text-transform:uppercase;margin-bottom:22px;font-family:'Inter',sans-serif}
.dtmx-cover .dtmx-ct{font-size:46px;font-weight:800;color:#fff;letter-spacing:-1.5px;line-height:1.06;margin-bottom:20px;max-width:820px}
.dtmx-cover .dtmx-cs{font-size:19px;font-weight:400;color:#94a3b8;max-width:720px;line-height:1.5}
.dtmx-cover .dtmx-logo{position:absolute;bottom:32px;right:64px;font-size:16px;font-weight:700;color:rgba(255,255,255,.28);letter-spacing:1px}
.dtmx-cover .dtmx-tag{display:inline-flex;align-items:center;gap:7px;background:rgba(20,184,166,.12);border:1px solid rgba(20,184,166,.3);
  border-radius:99px;padding:5px 14px;font-size:11px;font-weight:600;color:var(--teal);width:fit-content;margin-bottom:22px;font-family:'DM Mono',monospace}

/* thesis */
.dtmx-thesis-hero{background:var(--navy);border-radius:12px;padding:18px 22px;color:#fff;flex-shrink:0}
.dtmx-thesis-hero .dtmx-lbl{font-size:10px;font-weight:700;letter-spacing:1.5px;text-transform:uppercase;color:var(--teal);margin-bottom:8px;font-family:'DM Mono',monospace}
.dtmx-thesis-hero .dtmx-big{font-size:22px;font-weight:700;line-height:1.25;font-family:'DM Sans',sans-serif;letter-spacing:-0.3px}
.dtmx-thesis-hero .dtmx-big em{color:var(--teal);font-style:normal}
.dtmx-two-col{display:grid;grid-template-columns:1fr 1fr;gap:14px;flex:1;min-height:0}
.dtmx-tcard{border:1px solid var(--border);border-radius:10px;padding:13px 16px;display:flex;flex-direction:column;gap:5px;background:var(--surface)}
.dtmx-tcard .dtmx-tlbl{font-size:9px;font-weight:700;letter-spacing:1px;text-transform:uppercase;color:var(--ts);font-family:'DM Mono',monospace}
.dtmx-tcard .dtmx-th{font-size:13px;font-weight:700;color:var(--tp);line-height:1.3}
.dtmx-tcard .dtmx-tt{font-size:11px;color:var(--ts);line-height:1.5}
.dtmx-tcard.blk{border-left:3px solid var(--neg)}
.dtmx-tcard.grn{border-left:3px solid var(--pos)}

/* market strip */
.dtmx-mkt{display:flex;gap:0;border:1px solid var(--border);border-radius:10px;overflow:hidden;flex-shrink:0}
.dtmx-mkt .dtmx-mc{flex:1;padding:10px 16px;text-align:center;border-right:1px solid var(--border)}
.dtmx-mkt .dtmx-mc:last-child{border-right:none}
.dtmx-mkt .dtmx-mv{font-size:22px;font-weight:800;color:var(--tp);line-height:1;font-family:'DM Sans',sans-serif}
.dtmx-mkt .dtmx-ml{font-size:9.5px;color:var(--ts);margin-top:4px;font-weight:500}

/* kpi grid */
.dtmx-kpis{display:grid;grid-template-columns:repeat(5,1fr);gap:10px;flex-shrink:0}
.dtmx-kpi{background:var(--bg);border:1px solid var(--border);border-radius:8px;padding:12px 13px}
.dtmx-kpi .dtmx-kl{font-size:9px;font-weight:700;color:var(--teal);text-transform:uppercase;letter-spacing:.8px;margin-bottom:7px;white-space:nowrap;font-family:'DM Mono',monospace}
.dtmx-kpi .dtmx-kv{font-size:24px;font-weight:700;color:var(--tp);line-height:1;font-family:'DM Sans',sans-serif}
.dtmx-kpi .dtmx-kd{font-size:10px;margin-top:6px;color:var(--ts);line-height:1.5}
.dtmx-pos{color:var(--pos);font-weight:600}.dtmx-neg{color:var(--neg);font-weight:600}

/* ICP cards */
.dtmx-icp-row{display:grid;grid-template-columns:repeat(3,1fr);gap:12px;flex:1;min-height:0}
.dtmx-icp{border:1px solid var(--border);border-radius:10px;overflow:hidden;display:flex;flex-direction:column;background:var(--bg)}
.dtmx-icp .dtmx-photo{width:100%;height:76px;object-fit:cover;object-position:center 26%;flex-shrink:0;display:block}

/* conversion chart (slide 2) */
.dtmx-convo-card{border:1px solid var(--border);border-radius:10px;padding:9px 14px 7px;display:flex;flex-direction:column;gap:3px;flex-shrink:0;background:var(--bg)}
.dtmx-convo-head{display:flex;align-items:center;justify-content:space-between;gap:12px}
.dtmx-convo-title{font-size:10px;font-weight:700;color:var(--ts);text-transform:uppercase;letter-spacing:.5px;font-family:'DM Mono',monospace}
.dtmx-convo-title b{color:var(--tp)}
.dtmx-convo-legend{display:flex;gap:12px}
.dtmx-convo-legend .dtmx-li{display:flex;align-items:center;gap:5px;font-size:9px;color:var(--ts);font-weight:500}
.dtmx-convo-legend .dtmx-sw{width:10px;height:10px;border-radius:2px;display:inline-block}
.dtmx-convo-legend .dtmx-ln{width:15px;height:2px;border-radius:1px;display:inline-block;background:#1e3a6e}
.dtmx-convo-chart{position:relative;width:100%;height:138px}

/* quadrant (slide 4) */
.dtmx-quad-frame{font-size:11.5px;color:var(--ts);line-height:1.4;flex-shrink:0}
.dtmx-quad-frame b{color:var(--tp);font-weight:600}
.dtmx-quad-frame .dtmx-a{color:#0f766e;font-weight:700}
.dtmx-quad-row{flex:1;display:flex;gap:14px;min-height:0}
.dtmx-quad-wrap{flex:1;display:flex;flex-direction:column;min-height:0;gap:5px}
.dtmx-quad-main{flex:1;display:flex;min-height:0}
