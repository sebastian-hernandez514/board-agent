                  <div class="plan-name">Independiente</div>
                  <div class="plan-rfc">Hasta 10 RFC</div>
                  <div class="plan-price">$590<span>/mes</span></div>
                  <div class="plan-check">Facturación incluida</div>
                </div>
                <div class="plan-card rec">
                  <div class="plan-badge">Recomendado</div>
                  <div class="plan-name">Despacho</div>
                  <div class="plan-rfc">Hasta 25 RFC</div>
                  <div class="plan-price">$990<span>/mes</span></div>
                  <div class="plan-check">Facturación incluida</div>
                </div>
                <div class="plan-card">
                  <div class="plan-name">Firma</div>
                  <div class="plan-rfc">Hasta 50 RFC</div>
                  <div class="plan-price">$1,490<span>/mes</span></div>
                  <div class="plan-check">Facturación incluida</div>
                </div>
                <div class="plan-card">
                  <div class="plan-name">Firma Enterprise</div>
                  <div class="plan-rfc">+50 RFC · bloques</div>
                  <div class="plan-price custom">A medida</div>
