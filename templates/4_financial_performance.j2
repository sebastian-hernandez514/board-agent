<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1.0">
<title>Financial Performance · August 2026</title>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=DM+Sans:ital,wght@0,300;0,400;0,500;1,300&family=DM+Mono:wght@400;500&display=swap" rel="stylesheet">
<script src="https://cdnjs.cloudflare.com/ajax/libs/Chart.js/4.4.1/chart.umd.js"></script>
<style>
*,*::before,*::after{box-sizing:border-box;margin:0;padding:0}
:root{
  --color-navy:#0f172b;--color-bg:#ffffff;--color-surface:#f8fafc;
  --color-border:#e2e8f0;--color-teal:#14b8a6;--color-teal-light:#f0fdfa;
  --color-positive:#16a34a;--color-negative:#dc2626;--color-neutral:#64748b;
  --color-text-primary:#0f172b;--color-text-secondary:#64748b;--color-amber:#d97706;
  --slide-pad-x:32px;--slide-pad-y:20px;
}
body{font-family:'Inter',sans-serif;background:#dde3ea;display:flex;flex-direction:column;align-items:center;padding:24px 16px;min-height:100vh;color:var(--color-text-primary)}
/* Regla .slide{...} removida (2026-09-23, mismo hallazgo recurrente que 2026-07-21/27,
   2026-08-17, 2026-09-18 — Finance regenera este archivo desde cero cada vez que actualiza
   su HTML, así que el CSS muerto reaparece cada vez): ningún elemento de este archivo usa
   class="slide" (todos usan "board-slide"). Al fusionarse con los otros 7 templates en un
   solo <style> global (merge_standalone.py), esta regla pisaba el background navy de
   .slide-cover (1_inicio.j2) por empate de especificidad + orden en la cascada — la
   portada del board quedaba blanco-sobre-blanco. Si vuelve a aparecer la próxima vez que
   Finance mande un HTML nuevo, aplicar el mismo fix: borrar la línea `.slide{...}`. */

/* slide-header */
.slide-header{background:var(--color-navy);padding:14px var(--slide-pad-x);display:flex;justify-content:space-between;align-items:center}
.slide-header-title{font-size:16px;font-weight:600;color:#fff}
.slide-header-sub{font-size:13px;font-weight:500;color:var(--color-teal)}

/* toolbar — two independent groups */
.toolbar{padding:11px var(--slide-pad-x) 10px;display:flex;align-items:center;justify-content:space-between;border-bottom:1px solid var(--color-border)}
.tb-l,.tb-r{display:flex;align-items:center;gap:5px}
.tb-lbl{font-size:10px;color:var(--color-text-secondary);font-weight:600;text-transform:uppercase;letter-spacing:.8px;margin-right:4px}
.tb-sep{width:1px;height:18px;background:var(--color-border);margin:0 6px}
.pb{padding:4px 13px;border-radius:20px;border:1.5px solid var(--color-border);background:var(--color-bg);font-size:11px;font-weight:500;color:var(--color-text-secondary);cursor:pointer;transition:all .15s}
.pb:hover{border-color:var(--color-teal);color:var(--color-teal)}
.pb.month-act{background:var(--color-navy);border-color:var(--color-navy);color:#fff}
.vb{padding:4px 13px;border-radius:20px;border:1.5px solid var(--color-border);background:var(--color-bg);font-size:11px;font-weight:500;color:var(--color-text-secondary);cursor:pointer;transition:all .15s}
.vb:hover{border-color:var(--color-teal);color:var(--color-teal)}
.vb.view-act{background:var(--color-teal);border-color:var(--color-teal);color:#fff}

/* slide-body */
.slide-body{padding:var(--slide-pad-y) var(--slide-pad-x);overflow-x:auto}

/* kpi-grid / kpi-card */
.kpi-grid{display:grid;grid-template-columns:repeat(5,1fr);gap:10px;margin-bottom:14px}
@media(max-width:700px){.kpi-grid{grid-template-columns:repeat(2,1fr)}}
@media(max-width:460px){.kpi-grid{grid-template-columns:repeat(2,1fr)}}
.kpi-card{background:var(--color-bg);border:0.5px solid var(--color-border);border-radius:8px;padding:16px 12px;min-width:0}
.kpi-label{font-size:10px;font-weight:700;color:var(--color-teal);text-transform:uppercase;letter-spacing:1px;margin-bottom:8px;white-space:nowrap}
.kpi-value{font-size:30px;font-weight:700;color:var(--color-text-primary);line-height:1;margin-bottom:12px;white-space:nowrap}
.kpi-comps{display:flex;flex-direction:column;gap:4px}
.kpi-comp-row{display:flex;justify-content:space-between;align-items:center;gap:4px;padding:3px 5px;border-radius:5px;background:var(--color-surface)}
.kpi-comp-label{font-size:9.5px;color:var(--color-text-secondary);font-weight:500;white-space:nowrap;flex-shrink:0}

/* badges */
.bv{font-size:10.5px;font-weight:500;display:inline-flex;align-items:center;gap:2px;white-space:nowrap}
.bv .pp{font-size:9px;opacity:.8;margin-left:1px}
.pos{color:var(--color-positive)}.neg{color:var(--color-negative)}.amb{color:var(--color-amber)}.neu{color:var(--color-neutral)}

/* FYE */
.fye-bar{background:#eff6ff;border:1px solid #bfdbfe;border-radius:8px;padding:9px 16px;display:flex;justify-content:space-between;align-items:center;margin-bottom:14px}
.fye-l{display:flex;align-items:center;gap:20px}
.fye-tag{font-size:10px;font-weight:700;color:#1e40af;text-transform:uppercase;letter-spacing:.8px;margin-right:4px}
.fye-i{font-size:13px;color:var(--color-text-primary)}
.fye-i b{font-weight:700;color:#1e3a8a}
.fye-i span{color:var(--color-neutral);font-size:11.5px;margin-left:3px}
.fye-r{font-size:10.5px;color:#3b82f6;font-style:italic}

/* sec-t */
.sec-t{font-size:10px;font-weight:700;color:var(--color-teal);text-transform:uppercase;letter-spacing:1.5px;margin-bottom:8px}

/* trend charts */
.trend-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:10px;margin-bottom:14px}
@media(max-width:700px){.trend-grid{grid-template-columns:repeat(2,1fr)}}
@media(max-width:460px){.trend-grid{grid-template-columns:1fr}}
.tc{background:var(--color-bg);border:0.5px solid var(--color-border);border-radius:8px;padding:12px 14px;min-width:0}
.tc-head{display:flex;justify-content:space-between;align-items:flex-start;margin-bottom:6px}
.tc-lbl{font-size:10px;font-weight:700;color:var(--color-teal);text-transform:uppercase;letter-spacing:1.5px}
.tc-val{font-size:15px;font-weight:700;color:var(--color-text-primary)}
.tc-sub{font-size:9px;color:var(--color-neutral);margin-top:2px;text-align:right}
.tc-canvas{position:relative;width:100%;height:82px}
.tc-canvas canvas{display:block;width:100%!important;height:100%!important}
.tc-legend{display:flex;gap:10px;margin-top:5px}
.tcl-i{display:flex;align-items:center;gap:4px;font-size:8px;color:var(--color-neutral)}
.tcl-d{width:10px;height:2px;border-radius:1px;flex-shrink:0}
.tcl-d.act{background:var(--color-teal)}.tcl-d.bud{background:#94a3b8}

/* insight-box */
.insight-box{background:var(--color-teal-light);border-left:3px solid var(--color-teal);border-radius:0 6px 6px 0;padding:12px 16px;margin-bottom:14px;font-size:13px;color:var(--color-text-secondary);line-height:1.6}
.insight-box b{color:var(--color-text-primary);font-weight:600}

/* data-table */
.data-table{width:100%;border-collapse:collapse;font-size:13px}
.data-table thead tr{background:var(--color-navy)}
.data-table thead th{padding:8px 9px;text-align:right;font-size:10px;font-weight:600;color:#94a3b8;white-space:nowrap;letter-spacing:.4px}
.data-table thead th:first-child{text-align:left;padding-left:12px;color:#fff}
.data-table thead th.tha{color:#fff}
.data-table tbody tr{border-top:1px solid var(--color-border)}
.data-table tbody tr:hover{background:#fafafa}

.row-section td{padding:9px 9px;font-weight:700;background:var(--color-surface)}
.row-section .n0{padding-left:10px;display:flex;align-items:center;gap:5px;cursor:pointer}
.row-sub td{padding:6px 9px;background:var(--color-bg)}
.row-sub .n0{padding-left:26px;font-size:12px;color:var(--color-text-secondary)}
.row-calc td{padding:9px 9px;font-weight:700;background:var(--color-bg)}
.row-calc .n0{padding-left:12px}
.row-margin td{padding:4px 9px;font-style:italic;color:var(--color-neutral);font-size:12px;background:var(--color-bg)}
.row-margin .n0{padding-left:22px}
.row-divider td{height:3px;background:var(--color-surface);padding:0}
.row-group-hd td{padding:8px 9px 6px;font-size:10px;font-weight:700;color:var(--color-teal);text-transform:uppercase;letter-spacing:1.5px;background:var(--color-surface);cursor:pointer}
.row-group-hd .n0{padding-left:10px;display:flex;align-items:center;gap:5px}
.row-fo td{padding:10px 9px;font-weight:700;font-size:13px;background:#f0fdf4}
.row-fo .n0{padding-left:12px}

.tn{text-align:right;font-variant-numeric:tabular-nums;white-space:nowrap}
.tm{text-align:right;color:var(--color-neutral);font-variant-numeric:tabular-nums;white-space:nowrap;font-size:12px}
.tv{text-align:right;white-space:nowrap}
.eb{background:none;border:none;cursor:pointer;width:14px;height:14px;display:flex;align-items:center;justify-content:center;color:var(--color-neutral);font-size:9px;transition:transform .18s;flex-shrink:0}
.eb.o{transform:rotate(90deg)}

/* tooltips */
.tip-wrap{position:relative;display:inline-flex;align-items:center;gap:3px}
.tip-dot{font-size:10px;cursor:default;opacity:.55;line-height:1;transition:opacity .15s}
.tip-wrap:hover .tip-dot{opacity:1}
.tip-box{display:none;position:absolute;bottom:calc(100% + 7px);left:50%;transform:translateX(-50%);min-width:210px;max-width:270px;background:var(--color-navy);color:#cbd5e1;font-size:11px;line-height:1.55;padding:9px 11px;border-radius:7px;box-shadow:0 6px 20px rgba(0,0,0,.28);font-weight:400;font-style:normal;z-index:200;white-space:normal;text-align:left;pointer-events:none}
.tip-box::after{content:'';position:absolute;top:100%;left:50%;transform:translateX(-50%);border:5px solid transparent;border-top-color:var(--color-navy)}
.tip-wrap:hover .tip-box{display:block}

/* slide-footer */
.slide-footer{background:var(--color-surface);border-top:1px solid var(--color-border);padding:10px var(--slide-pad-x);display:flex;justify-content:space-between;align-items:center}
.slide-footer span{font-size:11px;font-weight:400;color:var(--color-neutral)}
/* responsive overrides */
@media(max-width:640px){
  :root{--slide-pad-x:16px;--slide-pad-y:14px}
  .slide-body{overflow-x:auto}
  .data-table{font-size:11px;min-width:560px}
  .toolbar{flex-wrap:wrap;gap:8px}
}

/* ===== injected: tabs + board ===== */
.app-tabbar{position:fixed;top:0;left:0;right:0;z-index:50;display:flex;gap:6px;align-items:center;background:#0f172b;padding:10px 18px;border-radius:0 0 10px 10px}
body{padding-top:56px}
.app-tabbar .brand{color:#fff;font-weight:700;font-size:13px;margin-right:14px}
.tab-btn{padding:8px 18px;font-size:12px;font-weight:600;cursor:pointer;border:none;border-radius:8px;background:rgba(255,255,255,.10);color:#cbd5e1}
.tab-btn.active{background:#14b8a6;color:#06231f}
.app-tabbar .spacer{flex:1}
.app-tabbar .pdf{background:#fff;color:#0f172b;border:none;border-radius:8px;padding:8px 14px;font-size:12px;font-weight:600;cursor:pointer}
.tab-page{display:none;min-width:0;width:100%}.tab-page.active{display:block}
/* board panel */
#tab-board{background:#dde3ea;padding:24px 16px;display:none;flex-direction:column;align-items:center;gap:24px;border-radius:10px}
#tab-board.active{display:flex}
.board-slide{width:960px;min-height:540px;background:#fff;border-radius:10px;display:flex;flex-direction:column;box-shadow:0 6px 28px rgba(15,23,43,.12);overflow:hidden}
.board-slide .slide-header{background:#0f172b;padding:14px 40px;display:flex;justify-content:space-between;align-items:center;gap:16px}
.board-slide .slide-body{padding:16px 40px 12px;flex:1;display:flex;flex-direction:column;gap:8px;height:460px;overflow:hidden}
.board-slide .slide-footer{background:#f8fafc;border-top:1px solid #e2e8f0;padding:8px 40px;display:flex;justify-content:space-between;font-size:9.5px;color:#94a3b8;font-family:'DM Mono',monospace}
.board-slide .sh-title{font-family:'DM Sans',sans-serif;font-size:14px;font-weight:600;color:#fff;line-height:1.3;max-width:680px}
.board-slide .sh-right{display:flex;align-items:center;gap:14px;flex-shrink:0}
.board-slide .sh-period{font-family:'DM Sans',sans-serif;font-size:11px;font-weight:500;color:#14b8a6;white-space:nowrap}
.board-slide .sh-num{font-family:'DM Mono',monospace;font-size:10px;font-weight:500;color:rgba(255,255,255,.35);white-space:nowrap}
.board-slide .footer-brand{font-family:'DM Sans',sans-serif;font-size:10px;font-weight:500;color:#cbd5e1}
.board-slide .footer-page{font-family:'DM Sans',sans-serif;font-size:10px;font-weight:500;color:#94a3b8}
.board-slide .dt{width:100%;border-collapse:collapse;font-family:'DM Mono',monospace}
.board-slide .dt thead th{background:#0f172b;color:#e2e8f0;font-size:8.5px;font-weight:600;padding:7px 8px;text-align:right;text-transform:uppercase;letter-spacing:.5px}
.board-slide .dt thead th:first-child{text-align:left}
.board-slide .dt thead th.thh{background:#1e3a5f;color:#7dd3fc}
.board-slide .dt thead th.thb{background:#1e3060;color:#c7d2fe}
.board-slide .dt thead th.tha{color:#e2e8f0}
.board-slide .dt td{padding:5px 8px;text-align:right;font-size:9.5px;border-top:1px solid #eef2f7}
.board-slide .dt td:first-child{text-align:left;font-family:'Inter',sans-serif}
.board-slide .dt tr.rs td{background:#f8fafc;color:#14b8a6;font-size:8px;font-weight:700;text-transform:uppercase;letter-spacing:.6px;padding:4px 8px 2px;border-top:2px solid #e2e8f0}
.board-slide .dt tr.rb td{background:#fff;color:#0f172b;font-size:9.5px;font-weight:700}
.board-slide .dt tr.rb td:first-child{padding-left:10px;font-family:'DM Sans',sans-serif;display:flex;align-items:center;gap:8px}
.board-slide .dt tr.rv td{background:#fff;color:#334155;font-size:9.5px}
.board-slide .dt tr.rv td:first-child{padding-left:18px;font-family:'DM Sans',sans-serif;display:flex;align-items:center;gap:8px}
.board-slide .dt tr.rp td{background:#fff;color:#64748b;font-size:8.5px;font-style:italic;padding:2px 8px 3px}
.board-slide .dt tr.rp td:first-child{padding-left:22px}
.board-slide .dt tr.rt td{background:#f1f5f9;color:#334155;font-size:9px;font-weight:600}
.board-slide .dt tr.re td{background:#0f172b;color:#e2e8f0;font-size:9.5px;font-weight:700}
.board-slide .dt tr.rem td{background:#0f172b;color:#94a3b8;font-size:8.5px;font-style:italic}
.board-slide .dt tr.rca td{background:#f8fafc;color:#334155;font-size:9.5px;font-weight:600}
.board-slide .dt tr.rca td:first-child{padding-left:10px;font-family:'DM Sans',sans-serif;display:flex;align-items:center;gap:8px}
.board-slide .dt tr.rsp td{height:4px;background:#fff;border:none}
.board-slide .dot{width:6px;height:6px;border-radius:50%;flex-shrink:0;display:inline-block}
.board-slide .dot-teal{background:#14b8a6}.board-slide .dot-green{background:#1D9E75}.board-slide .dot-gray{background:#94a3b8}.board-slide .dot-navy{background:#334155}
.board-slide .db{display:inline-flex;align-items:center;gap:2px;font-family:'DM Mono',monospace;font-size:8.5px;font-weight:600;padding:1px 5px;border-radius:99px}
.board-slide .db.p{color:#166534;background:#dcfce7}
.board-slide .db.n{color:#9a3412;background:#ffedd5}
.board-slide .db.z{color:#64748b;background:#f1f5f9}
.board-slide .db.pp{color:#1e40af;background:#dbeafe}
.board-slide .sec-label{font-family:'Inter',sans-serif;font-size:8.5px;font-weight:700;color:#14b8a6;text-transform:uppercase;letter-spacing:1.5px}
.board-slide .comments-box{background:#f8fafc;border-radius:8px;padding:10px 12px;display:flex;flex-direction:column;gap:7px}
.board-slide .comment-item{display:flex;gap:7px;align-items:flex-start;font-family:'Inter',sans-serif;font-size:10.5px;line-height:1.55;color:#334155}
.board-slide .comment-dot{width:6px;height:6px;border-radius:50%;flex-shrink:0;margin-top:4px}
.board-slide .comment-item b{color:#0f172b}
.board-slide .chart-wrap{position:relative;width:100%;overflow:hidden}
.board-slide .chart-wrap canvas{display:block;width:100%!important}
.board-slide .cf-table{width:100%;border-collapse:collapse}
.board-slide .cf-table thead th{background:#0f172b;color:#94a3b8;padding:4px 7px;text-align:right;font-family:'Inter',sans-serif;font-size:8px;font-weight:700;text-transform:uppercase;white-space:nowrap}
.board-slide .cf-table thead th:first-child{text-align:left;padding-left:10px;color:#e2e8f0}
.board-slide .cf-table thead th.tha{color:#e2e8f0}
.board-slide .cf-table td{padding:1.8px 7px;text-align:right;font-family:'DM Mono',monospace;font-size:9.5px;border-top:1px solid #e2e8f0;color:#334155}
.board-slide .cf-table td:first-child{text-align:left;padding-left:10px;font-family:'Inter',sans-serif;white-space:nowrap;font-size:9.5px}
.board-slide .cf-table tr.tot td{font-weight:700;background:#fff;color:#0f172b}
.board-slide .cf-table tr.sub td{font-weight:700;background:#f8fafc;color:#0f172b}
.board-slide .cf-table tr.ind td{color:#64748b}
.board-slide .cf-table tr.ind td:first-child{padding-left:20px}
.board-slide .cf-table tr.closing td{font-weight:700;background:#0f172b;color:#fff}
.board-slide .cf-table tr.closing td:first-child{font-family:'Inter',sans-serif}
.board-slide .appendix-divider{font-family:'Inter',sans-serif;font-size:8.5px;font-weight:700;color:#fff;letter-spacing:1.5px;text-transform:uppercase;background:#14b8a6;padding:2px 8px;border-radius:99px;margin-right:8px}
.board-slide .stat-grid{display:grid;gap:14px}
.board-slide .stat-card{background:#0f172b;border-radius:8px;padding:16px 18px;color:#fff}
.board-slide .stat-card .sv{font-family:'DM Sans',sans-serif;font-size:26px;font-weight:700;color:#14b8a6;line-height:1.1;margin-bottom:6px}
.board-slide .stat-card .sl{font-family:'Inter',sans-serif;font-size:10.5px;color:#cbd5e1;line-height:1.4}
.board-slide .note-box{background:#f0fdf9;border:1px solid #99f6e4;border-radius:8px;padding:12px 16px;font-family:'Inter',sans-serif;font-size:10.5px;color:#334155;line-height:1.55}
.board-slide .info-card{background:#f8fafc;border-radius:8px;padding:12px 14px;border:1px solid #e2e8f0}
.board-slide .info-card h4{font-family:'DM Sans',sans-serif;font-size:11.5px;font-weight:700;color:#0f172b;margin:0 0 6px}
.board-slide .info-card p{font-family:'Inter',sans-serif;font-size:10px;color:#475569;margin:0;line-height:1.5}
.board-slide .num-badge{display:inline-flex;align-items:center;justify-content:center;width:22px;height:22px;border-radius:50%;background:#14b8a6;color:#fff;font-family:'DM Mono',monospace;font-weight:700;font-size:11px;flex-shrink:0}
.board-slide .funnel-row{display:flex;align-items:center;gap:10px}
.board-slide .funnel-bar{height:32px;border-radius:6px;display:flex;align-items:center;padding:0 12px;color:#fff;font-family:'DM Sans',sans-serif;font-weight:700;font-size:15px}
.board-slide .funnel-label{font-family:'Inter',sans-serif;font-size:10.5px;color:#334155;font-weight:600;white-space:nowrap}
.board-slide .navy-box{background:#0f172b;color:#fff;border-radius:8px;padding:14px 16px}
.board-slide .navy-box h4{font-family:'DM Sans',sans-serif;font-size:11px;font-weight:700;color:#14b8a6;text-transform:uppercase;letter-spacing:.8px;margin:0 0 8px}
.board-slide .navy-box ul{margin:0;padding-left:16px;font-family:'Inter',sans-serif;font-size:10px;color:#e2e8f0;line-height:1.75}
.board-slide .rate-bar-row{display:flex;align-items:center;gap:8px;margin-bottom:6px}
.board-slide .rate-bar-label{width:82px;font-family:'Inter',sans-serif;font-size:9.5px;color:#334155;flex-shrink:0}
.board-slide .rate-bar-track{flex:1;background:#f1f5f9;border-radius:4px;height:14px;position:relative}
.board-slide .rate-bar-fill{background:#14b8a6;border-radius:4px;height:100%}
.board-slide .rate-bar-val{font-family:'DM Mono',monospace;font-size:9.5px;color:#334155;font-weight:600;width:36px;text-align:right;flex-shrink:0}
.board-slide .spike-bar-wrap{display:flex;align-items:flex-end;gap:28px;height:170px;padding:0 20px}
.board-slide .spike-bar-col{display:flex;flex-direction:column;align-items:center;justify-content:flex-end;height:100%;gap:6px}
.board-slide .spike-bar{width:70px;border-radius:4px 4px 0 0}
.board-slide .arrow-chip{color:#cbd5e1;font-size:16px}
@media print{.app-tabbar{display:none}.tab-page{display:block!important}#tab-board{background:#fff}.board-slide{box-shadow:none;page-break-after:always}}

/* Board Agent override (2026-09-23) — .app-tabbar es la barra de navegación del HTML
   standalone que pega Finance (título + botón "Export PDF" que llama a window.print()),
