<script>
const BD={opex:{sam:[4298000,4835000,5077000],rnd:[3861000,3928000,3028000],gna:[2091000,2213000,1946000]},
  cashLabels:["Q1'25","Q2'25","Q3'25","Q4'25","Q1'26","Q2'26"],
  cashAct:[5434,5086,4811,4223,4097,4502],
  cashBud:[null,null,null,null,2099,1967],
  burnLabels:["Q1'25","Q2'25","Q3'25","Q4'25","Q1'26","Q2'26"],
  burnDelta:[-541,-348,-275,-588,-126,405]};

function initBoardCharts(){
  if(window._boardInit) return;
  if(typeof Chart==='undefined') return;
  window._boardInit=true;
  const kf=v=>'$'+Math.round(v/1000).toLocaleString()+'k';
  // Slide 3 stacked
  var e1=document.getElementById('bd-opex-stacked');
  if(e1) new Chart(e1,{type:'bar',data:{labels:['Actuals','Budget','Y-1 (2025)'],datasets:[
    {label:'S&M',data:BD.opex.sam,backgroundColor:'#1D9E75',stack:'s'},
    {label:'R&D',data:BD.opex.rnd,backgroundColor:'#94a3b8',stack:'s'},
    {label:'G&A',data:BD.opex.gna,backgroundColor:'#14b8a6',stack:'s'}]},
    options:{responsive:false,plugins:{legend:{position:'bottom',labels:{font:{size:10},boxWidth:10}},
      tooltip:{callbacks:{label:c=>' '+c.dataset.label+': '+kf(c.raw)},
        footer:items=>'Total: '+kf(items.reduce((s,i)=>s+(i.raw||0),0))}},
      scales:{x:{stacked:true,grid:{display:false},ticks:{font:{size:10,weight:'600'}}},
              y:{stacked:true,ticks:{font:{size:9},callback:v=>kf(v)},grid:{color:'rgba(0,0,0,.05)'}}}}});
  // Slide 4 — Revenue Bridge
  (function(){
    var steps=[
      {l:'Net Rev -1',v:2341,t:'base'},{l:'Rec. P-1',v:88,t:'pos'},{l:'Pricing',v:91,t:'pos'},
      {l:'New Logos',v:195,t:'pos'},{l:'Reactivated',v:54,t:'pos'},{l:'Recovered',v:20,t:'pos'},
      {l:'Upgrades',v:38,t:'pos'},{l:'Efficiencies',v:-100,t:'neg'},{l:'Churn',v:-109,t:'neg'},
      {l:'Down+Mora',v:-113,t:'neg'},{l:'Opened cycles',v:-128,t:'neg'},
      {l:'FX Rate',v:89,t:'pos'},{l:'Subs. plans',v:32,t:'pos'},{l:'Closing Jun',v:2498,t:'close'}
    ];
    var run=0,fd=[],colors=[],labels=steps.map(function(s){return s.l;});
    steps.forEach(function(s){
      if(s.t==='base'){fd.push([0,s.v]);colors.push('#14b8a6');run=s.v;}
      else if(s.t==='close'){fd.push([0,s.v]);colors.push('#14b8a6');}
      else{var st=run,en=run+s.v;fd.push([Math.min(st,en),Math.max(st,en)]);colors.push(s.t==='pos'?'#1D9E75':'#C2410C');run=en;}
    });
    var e4=document.getElementById('bd-bridge');
    if(e4) new Chart(e4,{
      type:'bar',
      data:{labels:labels,datasets:[{data:fd,backgroundColor:colors,borderRadius:3,barPercentage:.55}]},
      options:{
        responsive:false,
        plugins:{legend:{display:false},tooltip:{backgroundColor:'#0f172b',titleColor:'#fff',bodyColor:'#94a3b8',padding:8,cornerRadius:6,
          callbacks:{label:function(ctx){var s=steps[ctx.dataIndex];return(s.v>=0?'+':'')+s.v+'K';}}}},
        scales:{
          x:{grid:{display:false},border:{display:false},ticks:{font:{size:7.5},color:'#94a3b8',maxRotation:40}},
          y:{grid:{color:'rgba(0,0,0,.05)'},border:{display:false},ticks:{font:{size:8,family:'monospace'},color:'#94a3b8',callback:function(v){return'$'+v+'K';}},min:2250,max:2900}
        }
      }
    });
  })();
  // Slide 6 line
  var e2=document.getElementById('bd-saldo');
  if(e2) new Chart(e2,{type:'line',data:{labels:BD.cashLabels,datasets:[
    {label:'Actual',data:BD.cashAct,borderColor:'#14b8a6',backgroundColor:'rgba(20,184,166,.08)',borderWidth:2.5,tension:.3,fill:true,pointRadius:2.5},
    {label:'Budget',data:BD.cashBud,borderColor:'#534AB7',borderDash:[5,4],borderWidth:2,tension:.3,fill:false,pointRadius:2,spanGaps:true}]},
    options:{responsive:false,plugins:{legend:{display:false}},
      scales:{x:{grid:{display:false},ticks:{font:{size:8},maxRotation:45,minRotation:30}},
              y:{ticks:{font:{size:8},callback:v=>'$'+v.toLocaleString()},grid:{color:'rgba(0,0,0,.05)'}}}}});
  // Slide 6 burn
  var e3=document.getElementById('bd-burn');
  if(e3) new Chart(e3,{type:'bar',data:{labels:BD.burnLabels,datasets:[
    {label:'Net CF',data:BD.burnDelta,backgroundColor:BD.burnDelta.map(v=>v>=0?'#1D9E75':'#E87722')}]},
    options:{responsive:false,plugins:{legend:{display:false}},
      scales:{x:{grid:{display:false},ticks:{font:{size:8},maxRotation:45,minRotation:30}},
              y:{ticks:{font:{size:8},callback:v=>'$'+v},grid:{color:'rgba(0,0,0,.05)'}}}}});
}

function switchTab(t){
  document.getElementById('tab-pl').classList.toggle('active',t==='pl');
  document.getElementById('tab-board').classList.toggle('active',t==='board');
  document.getElementById('tb-pl').classList.toggle('active',t==='pl');
  document.getElementById('tb-board').classList.toggle('active',t==='board');
  if(t==='board') setTimeout(initBoardCharts,40);
}
function exportPDF(){ window.print(); }
window.addEventListener('load',function(){ setTimeout(initBoardCharts,80); });
</script>
</body>
