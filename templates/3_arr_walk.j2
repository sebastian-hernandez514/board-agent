            {% for q in core_tbl.quarters %}<th class="awg-core-actual">{{ q }}</th>{% endfor %}
            <th class="awg-core-ytd">{{ ytd_lbl }}</th>
            {% for q in lite_tbl.quarters %}<th class="awg-lite-actual">{{ q }}</th>{% endfor %}
            <th class="awg-lite-ytd">{{ ytd_lbl }}</th>
          </tr>
        </thead>
        <tbody>
