<tr class="gw-lvl gw-first"><th class="gw-sec" scope="rowgroup" rowspan="3">Logos<span>000s</span></th><td class="gw-m">Logos, EoP</td>{% for v in g_eop_row.cells %}<td class="gw-v gw-h{% if loop.last %} gw-cur{% endif %}">{{ v }}</td>{% endfor %}<td class="gw-gap"></td><td class="gw-v gw-h">52.2</td><td class="gw-v gw-h">55.1</td><td class="gw-v gw-cur">60.7</td></tr>
<tr class="gw-row"><td class="gw-m">Logo Monthly New Adds %</td>{% for v in g_newpct_row.cells %}<td class="gw-v gw-h{% if loop.last %} gw-cur{% endif %}">{{ v }}</td>{% endfor %}<td class="gw-gap"></td><td class="gw-v gw-h">6.1%</td><td class="gw-v gw-h">5.0%</td><td class="gw-v gw-cur">5.1%</td></tr>
<tr class="gw-row"><td class="gw-m">Logo Monthly Churn %</td>{% for v in g_churnpct_row.cells %}<td class="gw-v gw-h{% if loop.last %} gw-cur{% endif %}">{{ v }}</td>{% endfor %}<td class="gw-gap"></td><td class="gw-v gw-h">4.5%</td><td class="gw-v gw-h">4.5%</td><td class="gw-v gw-cur">4.3%</td></tr>
<tr class="gw-lvl gw-first"><th class="gw-sec" scope="rowgroup" rowspan="10">ARR Walk<span>Spot, $M</span></th><td class="gw-m">ARR, BoP</td>{% for v in g_bop_row.cells %}<td class="gw-v gw-h{% if loop.last %} gw-cur{% endif %}">{{ v }}</td>{% endfor %}<td class="gw-gap"></td><td class="gw-v gw-h">13.2</td><td class="gw-v gw-h">18.4</td><td class="gw-v gw-cur">24.3</td></tr>
<tr class="gw-row"><td class="gw-m"><b class="gw-op">+</b>New (additions)</td>{% for v in g_add_row.cells %}<td class="gw-v gw-h{% if loop.last %} gw-cur{% endif %}">{{ v }}</td>{% endfor %}<td class="gw-gap"></td><td class="gw-v gw-h">6.1</td><td class="gw-v gw-h">7.0</td><td class="gw-v gw-cur">9.9</td></tr>
<tr class="gw-row"><td class="gw-m"><b class="gw-op">+</b>Recovered</td>{% for v in g_rec_row.cells %}<td class="gw-v gw-h{% if loop.last %} gw-cur{% endif %}">{{ v }}</td>{% endfor %}<td class="gw-gap"></td><td class="gw-v gw-h">1.5</td><td class="gw-v gw-h">1.9</td><td class="gw-v gw-cur">2.5</td></tr>
<tr class="gw-row"><td class="gw-m"><b class="gw-op">−</b>Churn, net¹</td>{% for v in g_nc_row.cells %}<td class="gw-v gw-h gw-neg{% if loop.last %} gw-cur{% endif %}">{{ v }}</td>{% endfor %}<td class="gw-gap"></td><td class="gw-v gw-h gw-neg">(5.6)</td><td class="gw-v gw-h gw-neg">(9.3)</td><td class="gw-v gw-cur gw-neg">(11.8)</td></tr>
