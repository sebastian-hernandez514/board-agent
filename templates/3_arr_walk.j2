            <td>{{ row.extra_sub.label }}</td>
            {% for v in row.extra_sub.cells %}<td{% if loop.last %} class="aw-cur"{% endif %}>{{ v }}</td>{% endfor %}
            <td></td><td></td><td></td>
          </tr>
