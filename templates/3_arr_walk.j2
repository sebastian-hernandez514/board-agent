<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Alegra Board — ARR Walk</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=DM+Sans:ital,opsz,wght@0,9..40,300;0,9..40,400;0,9..40,500;0,9..40,600;0,9..40,700;1,9..40,300&family=DM+Mono:wght@400;500&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="../styles/base.css">
  <script src="https://cdnjs.cloudflare.com/ajax/libs/Chart.js/4.4.1/chart.umd.js"></script>
  <style>
    /* Section cover */
    .section-cover {
      background: var(--color-navy);
      justify-content: center;
      padding: var(--slide-pad-y) var(--slide-pad-x);
    }
    .section-cover .eyebrow {
      font-size: 11px; font-weight: 600; color: var(--color-teal);
      letter-spacing: 2px; text-transform: uppercase; margin-bottom: 14px;
    }
    .section-cover .section-title {
      font-size: 42px; font-weight: 700; color: #ffffff;
      letter-spacing: -1.5px; line-height: 1.05; margin-bottom: 14px;
    }
    .section-cover .section-sub {
      font-size: 15px; font-weight: 400; color: rgba(255,255,255,0.40);
    }
    .section-cover .slide-num {
      position: absolute; bottom: 24px; right: var(--slide-pad-x);
      font-size: 10px; color: rgba(255,255,255,0.15);
    }

    /* ── ARR Walk Table (slides 2-3) — mismo sistema que 1_inicio slide 6 ── */
    .aw-sum-wrap { flex: 1; padding: 8px 90px 0; overflow: hidden; display: flex; flex-direction: column; }
    .aw-sum-table { width: 100%; border-collapse: collapse; }
    .aw-sum-table thead tr { border-bottom: 1.5px solid #e2e8f0; }
    .aw-sum-table thead th { text-align: right; font-size: 9.5px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.5px; color: #94a3b8; padding: 3px 7px 5px; white-space: nowrap; }
    .aw-sum-table thead th:first-child { text-align: left; padding-left: 4px; width: 200px; }
    .aw-sum-table thead th.aw-cur { color: #208080; background: rgba(48,184,183,0.09); border-radius: 4px 4px 0 0; }
    .aw-sum-table thead th.aw-ytd { font-size: 9px; color: #94a3b8; font-weight: 700; }
    .aw-sum-table thead th.aw-ytd-vs { color: #64748b; border-left: 1px solid #e2e8f0; }
    .aw-sum-table tbody td.aw-ytd-vs { border-left: 1px solid #e2e8f0; font-size: 9.5px; }
    .aw-sum-table tbody td { text-align: right; padding: 0 7px; height: 17px; font-family: 'DM Mono', monospace; font-size: 10px; color: #475569; white-space: nowrap; vertical-align: middle; border-bottom: 1px solid #f1f5f9; }
    .aw-sum-table tbody td:first-child { text-align: left; font-family: 'DM Sans', sans-serif; font-weight: 500; font-size: 11px; color: #475569; padding-left: 4px; }
    .aw-sum-table tbody td.aw-cur { background: rgba(48,184,183,0.07); color: #1a7e7f; font-weight: 600; }
    .aw-sum-table tbody td.aw-ytd { font-weight: 500; color: #475569; }
    tr.aw-rb td { font-weight: 700 !important; color: #1e293b !important; font-family: 'DM Sans', sans-serif !important; font-size: 10.5px !important; border-bottom: 1.5px solid #e2e8f0 !important; height: 19px !important; }
    tr.aw-rb td:first-child { color: #0f172b !important; }
    tr.aw-rb td.aw-cur { color: #1a7e7f !important; font-weight: 700 !important; background: rgba(48,184,183,0.09); }
    tr.aw-in td:first-child { padding-left: 20px; font-size: 10.5px; font-weight: 400; color: #64748b; }
    tr.aw-cc td { border-top: 1px dashed #cbd5e1 !important; }
    tr.aw-cc td:first-child { color: #0f172b !important; font-weight: 600 !important; font-size: 10.5px; }
    tr.aw-sh td { height: 15px !important; font-family: 'DM Sans', sans-serif !important; font-weight: 700 !important; font-size: 8.5px !important; text-transform: uppercase; letter-spacing: 1.4px; color: #0f172b !important; border-top: 1.5px solid #e2e8f0 !important; border-bottom: none !important; background: #f8fafc; padding-top: 3px !important; }
    tr.aw-sh td.aw-cur { background: rgba(48,184,183,0.07); color: #1a7e7f !important; }
    tr.aw-sh td:not(.aw-cur):not(:first-child) { background: #f8fafc; }
    tr.aw-rt td { height: 14px !important; font-size: 9.5px !important; color: #94a3b8 !important; border-bottom: 1px solid transparent !important; }
    tr.aw-delta-sub td { font-size:10px; color:#64748b; font-weight:400; border-bottom:none; height:15px !important; }
    tr.aw-delta-sub td:first-child { padding-left:20px; text-align:left; font-size:10px; font-weight:400; color:#64748b; }
    tr.aw-delta-sub td.aw-cur { background:rgba(48,184,183,0.07); }
    tr.aw-rt td:first-child { font-size: 10px !important; color: #94a3b8 !important; font-style: italic; padding-left: 20px; }
    tr.aw-rt td.aw-cur { color: #299e9c !important; }
    tr.aw-gap td { height: 3px; padding: 0; border: none !important; background: transparent !important; }
    .awdp { display:inline-block; font-family:'DM Sans',sans-serif; font-size:9.5px; font-weight:600; border-radius:4px; padding:1px 5px; line-height:1.45; }
    .awdp-b { background:rgba(24,95,165,0.10); color:#185FA5; }
    .awdp-o { background:rgba(232,119,34,0.10); color:#E87722; }
    .awdp-n { background:#f1f5f9; color:#64748b; }
    .aw-nv { color:#E87722 !important; }
    .aw-di { display:inline-block; width:6px; height:6px; border-radius:50%; margin-right:5px; vertical-align:middle; }
    .aw-di-g { background:#30b8b7; } .aw-di-b { background:#185FA5; }
    .aw-di-r { background:#E87722; } .aw-di-a { background:#f59e0b; } .aw-di-s { background:#cbd5e1; }

    /* ── Slide "ARR Walk — Core & Lite (Combined View)" (2026-10-21, pedido Lucas Vassalo) —
       tabla fusionada, columna de labels compartida (Core y Lite tienen las mismas filas),
       con bloques Core/Lite agrupados. Paleta limpia: fondo blanco, el color de cada
       producto queda solo en el texto "Core"/"Lite" + borde inferior — la separación entre
       bloques se marca con borde vertical, no con relleno de color. ── */
    .aw-merged { width: 100%; border-collapse: collapse; table-layout: fixed; }
    .aw-merged thead th { text-align: center; font-size: 8px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.3px; color: #94a3b8; padding: 3px 2px; white-space: nowrap; background: #fff; overflow: hidden; }
    tr.awg-group th.awg-core { color: #534AB7; font-size: 12px; font-weight: 700; letter-spacing: 0.3px; text-transform: none; padding: 4px; border-bottom: 3px solid #534AB7; }
    tr.awg-group th.awg-lite { color: #1D9E75; font-size: 12px; font-weight: 700; letter-spacing: 0.3px; text-transform: none; padding: 4px; border-bottom: 3px solid #1D9E75; border-left: 1px solid #e2e8f0; }
    tr.awg-sub th { font-size: 7.5px; color: #94a3b8; border-bottom: 1px solid #e2e8f0; }
    tr.awg-sub th.awg-lite-actual { border-left: 1px solid #e2e8f0; }
    tr.awg-q th { font-size: 8.5px; color: #475569; border-bottom: 1.5px solid #e2e8f0; padding: 3px 2px 4px; }
    tr.awg-q th.awg-core-ytd { font-weight: 700; border-left: 1px dashed #cbd5e1; }
    tr.awg-q th.awg-core-ytd + th.awg-lite-actual { border-left: 1px solid #e2e8f0; }
    tr.awg-q th.awg-lite-ytd { font-weight: 700; border-left: 1px dashed #cbd5e1; }
    /* 2026-10-23 — altura de fila bajada de 14.5px a 13px: Luis Caro pidió sumar las
       filas CAC y ARPA (base total) a "SaaS Metrics" (ver fetch_metrics.py), lo que agregó
       2 filas más a esta tabla ya ajustada y causó overflow silencioso (+18px, R18). Un
       primer ajuste a 13.5px lo dejó en 0px de margen real (sin cambiar el HTML, una
       corrida mostró +5px de overflow por variación de renderizado entre corridas de
       Playwright/Chromium headless) — bajado a 13px para dejar margen de verdad. */
    .aw-merged tbody td { text-align: right; padding: 0 3px; height: 13px; font-family: 'DM Mono', monospace; font-size: 9px; color: #475569; white-space: nowrap; border-bottom: 1px solid #f1f5f9; }
    .aw-merged tbody td:first-child { text-align: left; font-family: 'DM Sans', sans-serif; font-weight: 500; font-size: 9.5px; color: #475569; white-space: normal; }
    .aw-merged tbody td.awg-core-ytd { font-weight: 600; border-left: 1px dashed #cbd5e1; }
    .aw-merged tbody td.awg-core-ytd + td.awg-lite-actual { border-left: 1px solid #e2e8f0; }
    .aw-merged tbody td.awg-lite-ytd { font-weight: 600; border-left: 1px dashed #cbd5e1; }
    tr.aw-rb td { font-weight: 700 !important; color: #1e293b !important; font-family: 'DM Sans', sans-serif !important; font-size: 9.5px !important; border-bottom: 1.5px solid #e2e8f0 !important; }
    tr.aw-rb td:first-child { color: #0f172b !important; }
    tr.aw-in td:first-child { padding-left: 12px; font-weight: 400; color: #64748b; }
    tr.aw-sh td { height: 13px !important; font-family: 'DM Sans', sans-serif !important; font-weight: 700 !important; font-size: 7.5px !important; text-transform: uppercase; letter-spacing: 1px; color: #0f172b !important; border-top: 1.5px solid #e2e8f0 !important; border-bottom: none !important; background: #f8fafc !important; }

    /* ── Slide "ARR by Country — Version Comparison" (2026-10-21, pedido Lucas Vassalo) ── */
    .cv-table { width: 100%; border-collapse: collapse; }
    .cv-table thead tr.cv-group th { background: #0f172b; color: #fff; font-size: 8.5px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.4px; padding: 4px 3px; text-align: center; border-left: 1px solid rgba(255,255,255,0.25); }
    .cv-table thead tr.cv-group th:first-child { border-left: none; background: #0f172b; }
    .cv-table thead tr:not(.cv-group) th { font-size: 8px; font-weight: 600; color: #475569; text-align: right; padding: 3px 5px; border-bottom: 1.5px solid #cbd5e1; background:#f1f5f9; }
    .cv-table thead tr:not(.cv-group) th:first-child { text-align: left; background:#fff; border-bottom: 1.5px solid #cbd5e1;}
    .cv-table tbody td { text-align: right; padding: 3.5px 5px; font-family: 'DM Mono', monospace; font-size: 9.5px; color: #334155; border-bottom: 1px solid #f1f5f9; }
    .cv-table tbody td:first-child { text-align: left; font-family: 'DM Sans', sans-serif; font-weight: 500; font-size: 10px; color: #0f172b; }
    /* 2026-10-23 — pedido del usuario (ver tabla de referencia compartida): delimitar
       visualmente cada grupo de 3 columnas (una por período) con una línea vertical que
       baja desde el header hasta la última fila, y reforzar el contraste del total con un
       fondo gris sólido (antes solo tenía un borde superior, casi no se distinguía de las
       filas de países). Los grupos son de a 3 columnas (1 etiqueta + 4 grupos de 3) — el
       primer <th>/<td> de cada grupo (columnas 2, 5, 8, 11) lleva el borde izquierdo. */
    .cv-table thead tr:not(.cv-group) th:nth-child(2), .cv-table thead tr:not(.cv-group) th:nth-child(5),
    .cv-table thead tr:not(.cv-group) th:nth-child(8), .cv-table thead tr:not(.cv-group) th:nth-child(11),
    .cv-table tbody td:nth-child(2), .cv-table tbody td:nth-child(5),
    .cv-table tbody td:nth-child(8), .cv-table tbody td:nth-child(11) { border-left: 1px solid #cbd5e1; }
    .cv-table tbody tr.cv-total td { font-weight: 700; color: #0f172b; background: #e2e8f0; border-top: 1.5px solid #94a3b8; border-bottom: none; padding-top: 5px; padding-bottom: 5px; }
    .cv-table tbody tr.cv-total td:nth-child(2), .cv-table tbody tr.cv-total td:nth-child(5),
    .cv-table tbody tr.cv-total td:nth-child(8), .cv-table tbody tr.cv-total td:nth-child(11) { border-left: 1px solid #94a3b8; }
    .cv-cc.cv-flag { color: #C2410C; font-weight: 700; }

    /* ── Layout tabla + comentarios ── */
    .aw-body-row { flex: 1; display: flex; overflow: hidden; }
    .aw-sum-wrap { flex: 1; padding: 8px 16px 0 45px; overflow: hidden; display: flex; flex-direction: column; }
    .aw-comments-panel {
      width: 220px; flex-shrink: 0;
      padding: 10px 24px 10px 12px;
      border-left: 1px solid #e2e8f0;
      display: flex; flex-direction: column; gap: 10px;
    }
    .aw-comments-label {
      font-size: 8.5px; font-weight: 700; text-transform: uppercase;
      letter-spacing: 1.4px; color: #94a3b8;
    }
    .aw-comment-item {
      display: flex; flex-direction: column; gap: 3px;
    }
    .aw-comment-dot-row { display: flex; align-items: flex-start; gap: 7px; }
    .aw-comment-dot {
      width: 6px; height: 6px; border-radius: 50%;
      background: #cbd5e1; flex-shrink: 0; margin-top: 4px;
    }
    .aw-comment-text {
      font-size: 10.5px; font-family: 'DM Sans', sans-serif;
      color: #64748b; line-height: 1.5; flex: 1;
    }
    .aw-comment-line {
      height: 1px; background: #f1f5f9; width: 100%; margin: 2px 0;
    }
    .aw-comment-placeholder {
      height: 13px; background: #f8fafc; border-radius: 3px; width: 100%;
    }

    /* Redesign notice */
    .redesign-notice {
      display: flex; align-items: center; gap: 8px;
      background: #fefce8; border: 1px solid #fde047;
      border-radius: 6px; padding: 8px 14px;
      font-size: 11px; font-weight: 500; color: #854d0e;
      margin-bottom: 12px; flex-shrink: 0;
    }

    /* Waterfall table */
    .waterfall-table {
      width: 100%; border-collapse: collapse; font-size: 12px;
    }
    .waterfall-table td {
      padding: 7px 12px; border-bottom: 1px solid var(--color-border);
      color: var(--color-text-secondary);
    }
    .waterfall-table td:first-child {
      color: var(--color-text-primary); font-weight: 500; width: 40%;
    }
    .waterfall-table td:nth-child(2) { text-align: right; font-weight: 600; font-size: 13px; }
    .waterfall-table td:nth-child(3) { text-align: right; }
    .waterfall-table td:nth-child(4) { text-align: right; }

    .waterfall-table .row-start td,
    .waterfall-table .row-end td {
      background: var(--color-surface);
      font-weight: 700;
      color: var(--color-text-primary);
    }
    .waterfall-table .row-end td { border-top: 2px solid var(--color-navy); }

    .waterfall-table .row-positive td:first-child { border-left: 3px solid var(--color-positive); }
    .waterfall-table .row-negative td:first-child { border-left: 3px solid var(--color-negative); }
    .waterfall-table .row-neutral td:first-child  { border-left: 3px solid var(--color-border); }

    .val-positive { color: var(--color-positive) !important; }
    .val-negative { color: var(--color-negative) !important; }

    /* KPI mini row */
    .kpi-mini-row {
      display: flex; gap: 12px;
    }
    .kpi-mini {
      flex: 1; background: var(--color-surface);
      border: 1px solid var(--color-border);
      border-radius: 8px; padding: 12px 16px;
    }
    .kpi-mini .label { font-size: 11px; color: var(--color-text-secondary); font-weight: 500; margin-bottom: 4px; }
    .kpi-mini .value { font-size: 22px; font-weight: 700; color: var(--color-text-primary); letter-spacing: -0.5px; }
    .kpi-mini .delta { font-size: 11px; margin-top: 3px; font-weight: 500; }

    /* Country slide */
    .country-header-band {
      height: 4px; width: 100%; background: var(--color-teal); flex-shrink: 0;
    }

    .country-kpi-grid {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 12px;
    }

    .country-kpi {
      background: var(--color-surface);
      border: 1px solid var(--color-border);
      border-radius: 8px;
      padding: 14px 16px;
    }
    .country-kpi .label { font-size: 11px; color: var(--color-text-secondary); font-weight: 500; margin-bottom: 4px; text-transform: uppercase; letter-spacing: 0.4px; }
    .country-kpi .value { font-size: 26px; font-weight: 700; color: var(--color-text-primary); letter-spacing: -0.8px; line-height: 1; }
    .country-kpi .deltas { margin-top: 6px; display: flex; flex-direction: column; gap: 2px; }
    .country-kpi .delta { font-size: 11px; font-weight: 500; }

    .country-detail-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 16px;
      flex: 1;
    }

    .detail-block { display: flex; flex-direction: column; gap: 8px; }
    .detail-block .block-label {
      font-size: 10px; font-weight: 700; letter-spacing: 1.5px;
      text-transform: uppercase; color: var(--color-teal);
      padding-bottom: 7px; border-bottom: 1px solid var(--color-border);
    }

    .mini-table { width: 100%; border-collapse: collapse; font-size: 11.5px; }
    .mini-table th {
      text-align: right; font-size: 10px; font-weight: 600;
      color: var(--color-text-secondary); padding: 0 8px 6px;
      letter-spacing: 0.3px; border-bottom: 1px solid var(--color-border);
    }
    .mini-table th:first-child { text-align: left; }
    .mini-table td {
      padding: 6px 8px; text-align: right;
      color: var(--color-text-secondary);
      border-bottom: 1px solid var(--color-border);
      font-size: 11.5px;
    }
    .mini-table td:first-child { text-align: left; color: var(--color-text-primary); font-weight: 500; }
    .mini-table tr:last-child td { border-bottom: none; }

    .slide-divider { width: var(--slide-width); text-align: center; font-size: 11px; color: #9ca3af; letter-spacing: 1px; user-select: none; }

    /* ── Country Performance — rediseño 2026-09-29 (ver bloque idéntico en
       templates/1_inicio.j2, no diverger) ── */
    .cp-slide { display: flex; flex-direction: column; }
    .cp-slide .slide-header { background: #0f172b; padding: 11px 40px; display: flex; align-items: center; justify-content: space-between; flex-shrink: 0; }
    .cp-slide .slide-header .title { color: #fff; font-size: 15px; font-weight: 700; letter-spacing: -0.2px; }
    .cp-slide .slide-header .period { color: #14b8a6; font-size: 11.5px; font-weight: 500; }
    .cp-inner { padding: 13px 30px 4px; display: flex; flex-direction: column; gap: 9px; flex: 1; min-height: 0; }

    .hero { display: grid; grid-template-columns: minmax(0,1.2fr) minmax(0,2.67fr) 0.5px minmax(0,2.67fr); border: 0.5px solid #e5e5e5; border-radius: 10px; overflow: hidden; }
    .hero-spacer { background: #fafafa; }
    .hero-divider { background: #e5e5e5; }
    .hseg { padding: 13px 16px; }
    .seg-head { display: flex; align-items: center; gap: 6px; margin-bottom: 5px; }
    .dot { width: 7px; height: 7px; border-radius: 50%; }
    .dot.c { background: #534AB7; } .dot.l { background: #1D9E75; }
    .sname { font-size: 9px; font-weight: 600; letter-spacing: .08em; text-transform: uppercase; }
    .sname.c { color: #534AB7; } .sname.l { color: #1D9E75; }
    .sval { font-size: 22px; font-weight: 600; color: #111; line-height: 1; margin-bottom: 2px; }
    .slabel { font-size: 10px; color: #999; margin-bottom: 7px; }
    .sbottom { display: flex; align-items: center; gap: 14px; }
    .smom, .syoy { display: flex; flex-direction: column; gap: 1px; }
    .ml { font-size: 9px; color: #999; text-transform: uppercase; letter-spacing: .04em; }
    .mv { font-size: 13px; font-weight: 600; }
    .pos { color: #1D9E75; } .neg { color: #D85A30; }
    svg.spark { flex: 1; max-width: 90px; }

    .insight { display: flex; align-items: center; justify-content: space-between; background: #f5f5f3; border-radius: 8px; padding: 8px 13px; gap: 12px; }
    .it { font-size: 11px; font-weight: 600; color: #111; margin-bottom: 1px; }
    .is { font-size: 10px; color: #666; }
    .mix-lbl { font-size: 9px; color: #999; text-transform: uppercase; letter-spacing: .04em; margin-bottom: 3px; text-align: right; }
    .mix-bar { display: flex; gap: 2px; align-items: center; }
    .mb-c { height: 6px; background: #534AB7; border-radius: 2px 0 0 2px; }
    .mb-l { height: 6px; background: #1D9E75; border-radius: 0 2px 2px 0; }
    .mp { font-size: 10px; color: #666; margin-left: 4px; }

    .strip { border: 0.5px solid #e5e5e5; border-radius: 10px; overflow: hidden; }
    .gh { display: grid; grid-template-columns: minmax(0,1.2fr) minmax(0,2.67fr) 0.5px minmax(0,2.67fr); border-bottom: 0.5px solid #e5e5e5; background: #f5f5f3; }
    .gh-blank { padding: 5px 14px; }
    .gh-seg { display: flex; align-items: center; gap: 5px; padding: 5px 10px; }
    .gh-dot { width: 6px; height: 6px; border-radius: 50%; }
    .gh-dot.c { background: #534AB7; } .gh-dot.l { background: #1D9E75; }
    .gh-name { font-size: 9px; font-weight: 600; text-transform: uppercase; letter-spacing: .06em; }
    .gh-name.c { color: #534AB7; } .gh-name.l { color: #1D9E75; }
    .divider-v { background: #e5e5e5; align-self: stretch; }

    .st-head, .st-row { display: grid; grid-template-columns: minmax(0,1.2fr) minmax(0,.65fr) minmax(0,.56fr) minmax(0,.56fr) minmax(0,.9fr) 0.5px minmax(0,.65fr) minmax(0,.56fr) minmax(0,.56fr) minmax(0,.9fr); align-items: center; }
    .st-head { background: #f5f5f3; border-bottom: 0.5px solid #e5e5e5; }
    .st-row { height: 30px; border-bottom: 0.5px solid #f0f0f0; }
    .st-row:last-child { border-bottom: none; }

    .th { font-size: 9px; font-weight: 600; text-transform: uppercase; letter-spacing: .05em; color: #999; padding: 5px 8px; text-align: center; }
    .th.metric { text-align: left; padding-left: 14px; }
    .td { padding: 0 8px; font-size: 11.5px; color: #111; text-align: center; }
    .td.metric { padding: 0 8px 0 14px; font-size: 11.5px; font-weight: 500; text-align: left; }
    .td.val { font-weight: 600; }
    .td.delta { font-size: 11px; font-weight: 500; }
    .td.dv { background: #e5e5e5; padding: 0; align-self: stretch; }
    .th.dv { background: #e5e5e5; padding: 0; }

    .bspark { display: flex; align-items: flex-end; gap: 1.5px; height: 20px; padding: 0 8px; }
    .b { flex: 1; border-radius: 1px 1px 0 0; }
    .b.c { background: #AFA9EC; } .b.c.hi { background: #534AB7; }
    .b.l { background: #9FE1CB; } .b.l.hi { background: #1D9E75; }
    .b.w { background: #F0997B; } .b.w.hi { background: #D85A30; }

    /* ── Butterfly Country Performance — rediseño 2026-09-29 ── */
    .bf-cards { display: flex; gap: 14px; flex-shrink: 0; }
    .bf-card { flex: 1; border-radius: 8px; padding: 17px 22px; display: flex; align-items: center; gap: 20px; }
    .bf-card-id { display: flex; flex-direction: column; align-items: flex-start; gap: 5px; min-width: 116px; }
    .bf-card-label { font-size: 11px; font-weight: 800; letter-spacing: .08em; }
    .bf-card-label.c { color: #534AB7; } .bf-card-label.l { color: #1D9E75; }
    .bf-card-value { font-size: 33px; font-weight: 800; color: #0f172b; letter-spacing: -1px; line-height: 1; }
    .bf-card-deltas { display: flex; gap: 22px; flex: 1; }
    .bf-card-delta { display: flex; flex-direction: column; gap: 3px; }
    .bf-card-delta .k { font-size: 9px; font-weight: 600; letter-spacing: .03em; text-transform: uppercase; color: #94a3b8; }
    .bf-card-delta .v { font-size: 15px; font-weight: 700; font-family: 'DM Mono', monospace; }
    .bf-card-delta .v.cc { color: #64748b; font-weight: 600; }
    /* ── Country Performance Table ── */
    .bf-table { flex: 1; min-height: 0; }
    .bf-table table { width: 100%; border-collapse: collapse; }
    .bf-table thead .grp th { padding: 0 8px 3px; border-bottom: none; }
    .bf-table thead .grp .grp-label { display: block; text-align: center; font-size: 9.5px; font-weight: 800; letter-spacing: .1em; padding: 3px 0; border-radius: 4px 4px 0 0; }
    .bf-table thead .grp .grp-label.core { color: #534AB7; background: rgba(83,74,183,0.06); }
    .bf-table thead .grp .grp-label.lite { color: #1D9E75; background: rgba(29,158,117,0.06); }
    .bf-table thead .sub th { font-size: 9px; font-weight: 600; letter-spacing: .05em; text-transform: uppercase; color: #94a3b8; padding: 3px 8px 5px; border-bottom: 1px solid #eef0f3; }
    .bf-table thead .sub th.metric-h { text-align: left; }
    .bf-table th.right { text-align: right; } .bf-table th.left { text-align: left; } .bf-table th.center { text-align: center; }
    .bf-table th.core-col { background: rgba(83,74,183,0.06); }
    .bf-table th.lite-col { background: rgba(29,158,117,0.06); }
    .bf-table tbody tr { border-bottom: 1px solid #f5f6f8; }
    .bf-table tbody tr:last-child { border-bottom: none; }
    .bf-table td { padding: 4.8px 8px; font-size: 11.3px; vertical-align: middle; line-height: 1.2; }
    .bf-table td.right { text-align: right; } .bf-table td.left { text-align: left; }
    .bf-table td.core-col { border-left: 1px solid #eef0f3; }
    .bf-table td.lite-col { border-left: 1px solid #eef0f3; }
    .metric-col { display: flex; align-items: center; gap: 6px; white-space: nowrap; }
    .bf-table .metric-name { font-size: 11.5px; color: #475569; font-weight: 500; white-space: nowrap; }
    .bf-table .metric-name.primary { color: #0f172b; font-weight: 700; }
    .bf-table .val { font-family: 'DM Mono', monospace; font-size: 11.5px; font-weight: 700; color: #0f172b; white-space: nowrap; }
    .bf-table .val.alert { color: #D85A30; }
    .bf-table .delta { font-family: 'DM Mono', monospace; font-size: 10.5px; font-weight: 600; white-space: nowrap; }
    .bf-table .pos { color: #1D9E75; } .bf-table .neg { color: #D85A30; } .bf-table .neutral { color: #94a3b8; font-weight: 500; }

    /* ── ARR Walk Visual Chart (Slides 2–3) ── */
    .aw-content {
      font-family: 'DM Sans', sans-serif; color: #1A1917;
      -webkit-font-smoothing: antialiased;
      padding: 18px 28px 20px; display: flex; flex-direction: column; gap: 12px; flex: 1;
      --aw-surface: #FFFFFF; --aw-border: rgba(0,0,0,0.08); --aw-border-strong: rgba(0,0,0,0.14);
      --aw-text-primary: #1A1917; --aw-text-secondary: #6B6860; --aw-text-tertiary: #9E9C96;
      --aw-red-dark: #7C2D12; --aw-red-bg: #FFEDD5; --aw-dark-card: #1A1917;
      --aw-radius-xl: 16px; --aw-radius-lg: 12px;
    }
    .aw-hero-band { display: grid; grid-template-columns: repeat(4, 1fr); gap: 10px; }
    .aw-kpi-card {
      background: var(--aw-dark-card); border-radius: var(--aw-radius-xl);
      padding: 16px 18px 14px; display: flex; flex-direction: column;
      min-height: 108px; position: relative; overflow: hidden;
    }
    .aw-kpi-card::before {
      content: ''; position: absolute; inset: 0; border-radius: var(--aw-radius-xl);
      border: 0.5px solid rgba(255,255,255,0.07); pointer-events: none;
    }
    .aw-kpi-card.light { background: var(--aw-surface); border: 0.5px solid var(--aw-border-strong); }
    .aw-kpi-card.light::before { border-color: transparent; }
    .aw-kpi-card.light .aw-kpi-label { color: var(--aw-text-tertiary); }
    .aw-kpi-card.light .aw-kpi-num  { color: var(--aw-text-primary); }
    .aw-kpi-card.light .aw-kpi-num.red { color: #9A3412; }
    .aw-kpi-card.light .aw-kpi-sub  { color: var(--aw-text-tertiary); }
    .aw-kpi-card.light .aw-badge-r  { background: var(--aw-red-bg); color: var(--aw-red-dark); }
    .aw-kpi-card.light .aw-badge-rr { background: var(--aw-red-bg); color: var(--aw-red-dark); }
    .aw-kpi-card.light .aw-badge-n  { background: #F0EFE9; color: #6B6860; border: 0.5px solid rgba(0,0,0,0.1); }
    .aw-kpi-label {
      font-size: 9px; font-weight: 500; letter-spacing: 0.1em;
      text-transform: uppercase; color: rgba(255,255,255,0.35); margin-bottom: 8px;
    }
    .aw-kpi-num { font-size: 32px; font-weight: 300; letter-spacing: -1.5px; color: #fff; line-height: 1; flex: 1; }
    .aw-kpi-num.red { color: #FB923C; }
    .aw-kpi-num.sm  { font-size: 26px; letter-spacing: -1px; }
    .aw-kpi-badges  { display: flex; gap: 5px; flex-wrap: wrap; margin-top: 10px; }
    .aw-badge {
      display: inline-flex; align-items: center; gap: 3px;
      font-size: 10px; font-weight: 500; padding: 2px 8px; border-radius: 20px;
    }
    .aw-badge-g  { background: rgba(99,153,34,0.22);  color: #aada6e; }
    .aw-badge-g2 { background: rgba(29,158,117,0.2);  color: #5ecfaa; }
    .aw-badge-r  { background: rgba(221,107,32,0.2);   color: #fdba74; }
    .aw-badge-n  { background: rgba(255,255,255,0.09); color: rgba(255,255,255,0.55); border: 0.5px solid rgba(255,255,255,0.1); }
    .aw-badge-rr { background: rgba(221,107,32,0.15);  color: #fdba74; }
    .aw-kpi-sub { font-size: 10px; color: rgba(255,255,255,0.28); margin-top: 2px; }
    .aw-panel {
      background: var(--aw-surface); border: 0.5px solid var(--aw-border-strong);
      border-radius: var(--aw-radius-lg); padding: 16px 18px;
    }
    .aw-panel-label {
      font-size: 10px; font-weight: 500; letter-spacing: 0.1em; text-transform: uppercase;
      color: var(--aw-text-tertiary); margin-bottom: 10px; padding-bottom: 9px;
      border-bottom: 0.5px solid var(--aw-border);
    }
    .aw-chart-headline { font-size: 13px; font-weight: 500; margin-bottom: 2px; color: var(--aw-text-primary); }
    .aw-chart-subtitle { font-size: 11px; color: var(--aw-text-tertiary); margin-bottom: 10px; }
    .aw-chart-legend { display: flex; gap: 18px; margin-bottom: 10px; flex-wrap: wrap; align-items: center; }
    .aw-legend-item { display: flex; align-items: center; gap: 6px; font-size: 11px; color: var(--aw-text-secondary); }
    .aw-l-stack { display: flex; flex-direction: column; gap: 1px; flex-shrink: 0; }
    .aw-l-swatch-top { width: 10px; height: 5px; border-radius: 1px 1px 0 0; }
    .aw-l-swatch-bot { width: 10px; height: 5px; border-radius: 0 0 1px 1px; }
    .aw-l-line { width: 18px; height: 2px; border-radius: 1px; background: #1A1917; flex-shrink: 0; }
    .aw-chart-wrap { position: relative; height: 220px; }
    .aw-q-cards-wrap { display: flex; gap: 6px; margin-top: 8px; align-items: stretch; }
    .aw-q-labels-col {
      display: flex; flex-direction: column; justify-content: space-around;
      padding: 9px 0; flex-shrink: 0; width: 28px;
    }
    .aw-q-label-tag {
      font-size: 8.5px; font-weight: 500; letter-spacing: 0.07em; text-transform: uppercase;
      color: var(--aw-text-tertiary); flex: 1; display: flex; align-items: center;
    }
    .aw-q-label-tag + .aw-q-label-tag { border-top: 0.5px solid var(--aw-border); }
    .aw-q-cards { display: grid; grid-template-columns: repeat(5, 1fr); gap: 6px; flex: 1; }
    .aw-q-card {
      border: 0.5px solid var(--aw-border-strong); border-radius: 10px;
      display: flex; flex-direction: column; background: var(--aw-surface); overflow: hidden;
    }
    .aw-q-half {
      display: flex; flex-direction: column; align-items: center;
      justify-content: center; padding: 6px 5px; flex: 1; gap: 2px;
    }
    .aw-q-half + .aw-q-half { border-top: 0.5px solid var(--aw-border); }
    .aw-q-arr {
      font-size: 11px; font-weight: 600; color: var(--aw-text-primary);
      letter-spacing: -0.3px; font-family: 'DM Mono', monospace; text-align: center;
    }
    .aw-q-logos { font-size: 9px; color: var(--aw-text-tertiary); font-family: 'DM Mono', monospace; text-align: center; }

    /* ════════════════════════════════════════════════════════════════════
       Growth Slides (2026-10-23) — diseño nuevo pedido por el equipo para
       "ARR & Logo Walk GLO", "Core vs Lite Quarterly Performance", "ARR by
       Country" y "ARR by Country · Three-Year Detail". TODO escopado bajo
       .gw-slide — el diseño original (board_3Q26_growth_slides_review.html)
       define .slide/.hd/.body/.ft/.k/.t/.ct/etc. a nivel bare, que YA
       colisiona con styles/base.css (.slide) y con .k ya usado dentro de
       .bf-card-delta en este mismo archivo — mismo problema que resolvió
       4_financial_performance.j2 con su namespace .board-slide (ver ese
       archivo, líneas 1-48). Nunca agregar una regla bare .slide/.hd/.t/.k/
       etc. acá — todo va ".gw-slide .loquesea{...}". ════════════════════ */
    .gw-slide{
      --gw-navy:#0f172b; --gw-ink:#0f172b; --gw-ink-2:#334155; --gw-soft:#64748b; --gw-muted:#94a3b8; --gw-faint:#cbd5e1;
      --gw-hair:#edf0f4; --gw-rule:#e2e8f0; --gw-band:#f1f5f9;
      --gw-teal:#14b8a6; --gw-teal-ink:#1a7e7f; --gw-wash:rgba(48,184,183,.09);
      --gw-core:#534AB7; --gw-lite:#1D9E75; --gw-pos:#15803d; --gw-neg:#C2410C; --gw-neg-h:#d9774f;
      background:#fff;color:var(--gw-ink);
      font-family:'Inter',-apple-system,BlinkMacSystemFont,'Segoe UI',sans-serif;
      font-variant-numeric:tabular-nums;font-feature-settings:"tnum","cv11";
      -webkit-font-smoothing:antialiased;
    }
    .gw-slide .gw-hd{background:var(--gw-navy);height:38px;padding:0 40px;display:flex;justify-content:space-between;align-items:center;flex-shrink:0}
    .gw-slide .gw-hd h2{margin:0;color:#fff;font:700 15px/1 'Inter',sans-serif;letter-spacing:-.3px}
    .gw-slide .gw-hd span{color:var(--gw-teal);font:600 13px/1 'Inter',sans-serif;letter-spacing:.5px}
    .gw-slide .gw-body{flex:1;display:flex;flex-direction:column;gap:8px;padding:10px 40px 0;min-height:0}

    .gw-slide .gw-ft{margin-top:auto;display:flex;justify-content:space-between;align-items:flex-end;gap:24px;padding:6px 40px 9px;font-size:7.5px;line-height:1.5;color:var(--gw-muted);flex-shrink:0}
    .gw-slide .gw-ft p{margin:0}
    .gw-slide .gw-ft b{color:var(--gw-soft);font-weight:600}
    .gw-slide .gw-key{display:flex;flex-direction:column;align-items:flex-end;gap:3px;white-space:nowrap}
    .gw-slide .gw-key div{display:flex;gap:12px;font-weight:500;color:var(--gw-soft)}
    .gw-slide .gw-key span{display:inline-flex;align-items:center;gap:4px}
    .gw-slide .gw-key i{width:6px;height:6px;border-radius:50%;display:inline-block;background:var(--gw-neg)}
    .gw-slide .gw-key i.sw{width:12px;height:8px;border-radius:1px;background:rgba(48,184,183,.18)}
    .gw-slide .gw-key em{font-style:normal;color:var(--gw-faint);letter-spacing:.3px}

    .gw-slide .gw-ks{display:grid;border-bottom:1px solid var(--gw-hair)}
    .gw-slide .gw-ks.gw-c3{grid-template-columns:repeat(3,1fr)}
    .gw-slide .gw-ks.gw-c5{grid-template-columns:repeat(5,1fr);border-top:1px solid var(--gw-hair)}
    .gw-slide .gw-k{padding:8px 18px 10px;display:flex;flex-direction:column;gap:6px;min-width:0}
    .gw-slide .gw-k:first-child{padding-left:0}
    .gw-slide .gw-k:last-child{padding-right:0}
    .gw-slide .gw-k + .gw-k{border-left:1px solid var(--gw-hair)}
    .gw-slide .gw-k-top{display:flex;justify-content:space-between;align-items:baseline;gap:8px}
    .gw-slide .gw-k-lbl{font:700 9.5px/1 'DM Sans','Inter',sans-serif;letter-spacing:1.5px;text-transform:uppercase;color:var(--gw-ink-2);display:flex;align-items:center;gap:6px}
    .gw-slide .gw-k-lbl i{width:7px;height:7px;border-radius:50%;display:inline-block}
    .gw-slide .gw-k-mix{font:500 9px/1 'Inter',sans-serif;color:var(--gw-muted)}
    .gw-slide .gw-k-mid{display:flex;align-items:center;justify-content:space-between;gap:12px}
    .gw-slide .gw-k-val{font:700 27px/1 'Inter',sans-serif;letter-spacing:-1px;color:var(--gw-navy)}
    .gw-slide .gw-ks.gw-c5 .gw-k-val{font-size:24px}
    .gw-slide .gw-k-val small{font-size:12px;font-weight:600;letter-spacing:0;color:var(--gw-soft);margin-left:3px}
    .gw-slide .gw-k-dl{display:flex;gap:13px;flex-wrap:nowrap;white-space:nowrap}
    .gw-slide .gw-k-dl div{display:flex;flex-direction:row-reverse;align-items:baseline;gap:4px}
    .gw-slide .gw-k-dl b{font:600 7.5px/1 'DM Sans','Inter',sans-serif;letter-spacing:1px;text-transform:uppercase;color:var(--gw-muted)}
    .gw-slide .gw-k-dl span{font:600 11px/1 'Inter',sans-serif;color:var(--gw-ink)}
    .gw-slide .gw-k-dl span.nt{color:var(--gw-soft)}

    .gw-slide .gw-t{width:100%;border-collapse:collapse;table-layout:fixed;font-size:11px}
    .gw-slide .gw-t th,.gw-slide .gw-t td{padding:0 5px;height:var(--gw-rh,14px);text-align:right;white-space:nowrap}
    .gw-slide .gw-t col.gw-c-sec{width:78px} .gw-slide .gw-t col.gw-c-gap{width:12px}
    .gw-slide .gw-t thead tr.gw-seg th{height:17px;text-align:left;padding-left:6px;vertical-align:bottom;padding-bottom:3px;font:700 9.5px/1 'DM Sans','Inter',sans-serif;letter-spacing:1.6px;text-transform:uppercase;color:var(--gw-ink)}
    .gw-slide .gw-t thead tr.gw-seg th span{font:500 9px/1 'Inter',sans-serif;letter-spacing:.2px;text-transform:none;color:var(--gw-soft);margin-left:6px}
    .gw-slide .gw-t thead tr.gw-seg th.gw-sq{border-bottom:1.5px solid var(--gw-navy)}
    .gw-slide .gw-t thead tr.gw-seg th.gw-sltm{border-bottom:1.5px solid var(--gw-teal-ink);color:var(--gw-teal-ink)}
    .gw-slide .gw-t thead tr.gw-seg th.gw-sc{color:var(--gw-core);border-bottom:1.5px solid var(--gw-core)}
    .gw-slide .gw-t thead tr.gw-seg th.gw-sl{color:var(--gw-lite);border-bottom:1.5px solid var(--gw-lite)}
    .gw-slide .gw-t thead tr.gw-per th{height:17px;font:700 8.5px/1 'DM Sans','Inter',sans-serif;letter-spacing:1px;color:var(--gw-soft)}
    .gw-slide .gw-t thead tr.gw-per th.gw-cur{padding:0 4px}
    .gw-slide .gw-pill{display:inline-block;background:var(--gw-teal-ink);color:#fff;font:700 8.5px/1 'DM Sans','Inter',sans-serif;letter-spacing:1px;padding:3px 6px 3px 7px;border-radius:3px}
    .gw-slide .gw-t .gw-cur{background:var(--gw-wash)}
    .gw-slide .gw-t td.gw-gap,.gw-slide .gw-t th.gw-gap{padding:0;background:transparent;border:0!important}

    .gw-slide .gw-t th.gw-sec{text-align:left;vertical-align:top;padding:4px 0 0;font:700 8px/1.25 'DM Sans','Inter',sans-serif;letter-spacing:1.4px;text-transform:uppercase;color:var(--gw-ink);white-space:normal}
    .gw-slide .gw-t th.gw-sec span{display:block;margin-top:2px;font:500 8.5px/1.3 'Inter',sans-serif;letter-spacing:.1px;text-transform:none;color:var(--gw-soft)}

    .gw-slide .gw-t tbody tr.gw-first td.gw-m,.gw-slide .gw-t tbody tr.gw-first td.gw-v,.gw-slide .gw-t tbody tr.gw-first th.gw-sec{border-top:1px solid var(--gw-rule)}
    .gw-slide .gw-t tbody tr.gw-tot td.gw-m,.gw-slide .gw-t tbody tr.gw-tot td.gw-v{border-top:1px solid var(--gw-muted)}
    .gw-slide .gw-t tbody tr:last-child td.gw-m,.gw-slide .gw-t tbody tr:last-child td.gw-v{border-bottom:1px solid var(--gw-rule)}
    .gw-slide .gw-t tbody tr:last-child th.gw-sec{border-bottom:1px solid var(--gw-rule)}

    .gw-slide .gw-t td.gw-m{text-align:left;color:var(--gw-ink)}
    .gw-slide .gw-t td.gw-m small{color:var(--gw-muted);font-size:9px;margin-left:5px}
    .gw-slide .gw-t td.gw-m b.gw-op{display:inline-block;width:12px;font-weight:400;color:var(--gw-faint)}
    .gw-slide .gw-t td.gw-v{color:var(--gw-ink)}
    .gw-slide .gw-t td.gw-v.gw-h{color:var(--gw-ink-2)}
    .gw-slide .gw-t td.gw-v.gw-cur{font-weight:600;color:var(--gw-ink)}
    .gw-slide .gw-t tr.gw-lvl td.gw-v.gw-h{color:var(--gw-ink)}
    .gw-slide .gw-t td.gw-v.gw-neg{color:var(--gw-neg)}
    .gw-slide .gw-t td.gw-v.gw-h.gw-neg{color:var(--gw-neg-h)}
    .gw-slide .gw-t td.gw-v.gw-na{color:var(--gw-faint)}
    .gw-slide .gw-t td.gw-v.gw-ytd{color:var(--gw-ink-2)}
    .gw-slide .gw-t td.gw-v sup{font-size:7px;color:var(--gw-soft);margin-left:1px;vertical-align:4px}
    .gw-slide .gw-t tr.gw-lvl td.gw-m{color:var(--gw-ink);font-weight:700}
    .gw-slide .gw-t tr.gw-lvl td.gw-v{font-weight:600}
    .gw-slide .gw-t tr.gw-tot td.gw-m,.gw-slide .gw-t tr.gw-tot td.gw-v{font-weight:700}
    .gw-slide .gw-t tr.gw-lvl td.gw-v.gw-cur{color:#000;font-weight:700}
    .gw-slide .gw-t tr.gw-lvl td.gw-m,.gw-slide .gw-t tr.gw-lvl td.gw-v{background-image:linear-gradient(rgba(15,23,43,.035),rgba(15,23,43,.035))}
    .gw-slide .gw-t tr.gw-sub td.gw-m{padding-left:18px;color:var(--gw-soft);font-size:10px}
    .gw-slide .gw-t tr.gw-sub td.gw-v{color:var(--gw-soft);font-size:10px}
    .gw-slide .gw-t tr.gw-sub td.gw-v.gw-cur{color:var(--gw-ink);font-weight:600}
    .gw-slide .gw-t tr.gw-sub td.gw-v.gw-neg{color:var(--gw-neg)}
    .gw-slide .gw-t tr.gw-sub td.gw-v.gw-h.gw-neg{color:var(--gw-neg-h)}
    .gw-slide .gw-t tr.gw-sub td.gw-v.gw-na{color:var(--gw-faint)}

    .gw-slide .gw-t.gw-ap thead tr.gw-seg th{text-align:center;padding-left:0}
    .gw-slide .gw-t.gw-ap thead tr.gw-seg th.gw-blk{text-align:left;font-size:8px;letter-spacing:1.4px;color:var(--gw-teal-ink)}
    .gw-slide .gw-t.gw-ap tbody th[scope="row"]{text-align:left;padding-left:0;font-weight:600;color:var(--gw-ink)}
    .gw-slide .gw-t.gw-ap tbody tr td.gw-v,.gw-slide .gw-t.gw-ap tbody tr th[scope="row"]{border-top:1px solid var(--gw-hair)}
    .gw-slide .gw-t.gw-ap tbody tr:first-child td.gw-v,.gw-slide .gw-t.gw-ap tbody tr:first-child th[scope="row"]{border-top:1px solid var(--gw-rule)}
    .gw-slide .gw-t.gw-ap tbody tr.gw-tot td.gw-v,.gw-slide .gw-t.gw-ap tbody tr.gw-tot th[scope="row"]{border-top:1px solid var(--gw-muted);font-weight:600;color:var(--gw-ink)}
    .gw-slide .gw-t.gw-ap tbody tr.gw-tot td.gw-v.gw-h{color:var(--gw-ink)}
    .gw-slide .gw-t.gw-ap tbody tr.gw-tot td.gw-v,.gw-slide .gw-t.gw-ap tbody tr.gw-tot th[scope="row"]{font-weight:700;background-image:linear-gradient(rgba(15,23,43,.035),rgba(15,23,43,.035))}
    .gw-slide .gw-t.gw-ap tbody tr.gw-fx td.gw-v,.gw-slide .gw-t.gw-ap tbody tr.gw-fx th[scope="row"]{border-top:0;font-style:italic;font-weight:400;color:var(--gw-soft);font-size:9.5px;background-image:none}
    .gw-slide .gw-t.gw-ap tbody tr.gw-fx td.gw-v.gw-cur{font-style:normal;font-weight:600;color:var(--gw-ink)}
    .gw-slide .gw-t.gw-ap tbody tr.gw-fx td.gw-v.gw-h.gw-neg{color:var(--gw-neg-h)}
    .gw-slide .gw-t.gw-ap thead tr.gw-per th.gw-cur{color:var(--gw-teal-ink);font-weight:700}
    .gw-slide .gw-t.gw-ap td.gw-v.gw-cur{color:var(--gw-ink);font-weight:600}
    .gw-slide .gw-t.gw-ap tr.gw-tot td.gw-v.gw-cur{color:#000;font-weight:700}
    .gw-slide .gw-t.gw-ap td.gw-v.gw-flag{color:var(--gw-neg)} .gw-slide .gw-t.gw-ap td.gw-v.gw-h.gw-flag{color:var(--gw-neg-h)}

    .gw-slide .gw-ct{width:100%;border-collapse:collapse;table-layout:fixed;font-size:12px}
    .gw-slide .gw-ct th,.gw-slide .gw-ct td{padding:0 6px;text-align:right;white-space:nowrap}
    .gw-slide .gw-ct td{height:36px;color:var(--gw-ink);font-size:13px}
    .gw-slide .gw-ct thead tr.gw-seg th{height:17px;text-align:left;vertical-align:bottom;padding:0 0 3px 6px;font:700 9.5px/1 'DM Sans','Inter',sans-serif;letter-spacing:1.6px;text-transform:uppercase;color:var(--gw-ink);border-bottom:1.5px solid var(--gw-navy)}
    .gw-slide .gw-ct thead tr.gw-seg th span{font:500 9px/1 'Inter',sans-serif;letter-spacing:.2px;text-transform:none;color:var(--gw-soft);margin-left:6px}
    .gw-slide .gw-ct thead tr.gw-seg th.gw-blank{border-bottom:0}
    .gw-slide .gw-ct thead tr.gw-per th{height:20px;font:700 8.5px/1 'DM Sans','Inter',sans-serif;letter-spacing:.6px;color:var(--gw-soft);border-bottom:1px solid var(--gw-rule)}
    .gw-slide .gw-ct thead tr.gw-per th.gw-l{text-align:left}
    .gw-slide .gw-ct th.gw-gap,.gw-slide .gw-ct td.gw-gap{padding:0;border:0!important}
    .gw-slide .gw-ct tbody th[scope="row"]{text-align:left;padding-left:0;font-size:13px;font-weight:600;color:var(--gw-ink)}
    .gw-slide .gw-ct tbody tr td:not(.gw-gap),.gw-slide .gw-ct tbody tr th[scope="row"]{border-bottom:1px solid var(--gw-hair)}
    .gw-slide .gw-ct tbody tr.gw-tot td:not(.gw-gap),.gw-slide .gw-ct tbody tr.gw-tot th[scope="row"]{border-top:1px solid var(--gw-muted);border-bottom:1px solid var(--gw-rule);font-weight:700;color:#000;background:rgba(15,23,43,.035)}
    .gw-slide .gw-ct td.gw-cc{color:var(--gw-ink);font-weight:700}
    .gw-slide .gw-ct td.gw-bd{font-weight:600;font-size:12px}
    .gw-slide .gw-ct td.gw-bd.gw-up,.gw-slide .gw-k-bd .gw-up{color:var(--gw-pos)}
    .gw-slide .gw-ct td.gw-bd.gw-dn,.gw-slide .gw-k-bd .gw-dn{color:var(--gw-neg)}
    .gw-slide .gw-ct tbody tr.gw-tot td.gw-bd.gw-up{color:var(--gw-pos)}
    .gw-slide .gw-ct tbody tr.gw-tot td.gw-bd.gw-dn{color:var(--gw-neg)}
    .gw-slide .gw-dm{text-decoration:underline dotted;text-decoration-color:var(--gw-muted);text-underline-offset:3px}
    .gw-slide .gw-ct thead tr.gw-per th{letter-spacing:.3px;padding:0 4px}
    .gw-slide .gw-k-bd{font:500 8.5px/1 'DM Sans','Inter',sans-serif;letter-spacing:.6px;text-transform:uppercase;color:var(--gw-muted);display:flex;gap:4px;align-items:baseline}
    .gw-slide .gw-k-bd span{font:600 11px/1 'Inter',sans-serif;letter-spacing:0;text-transform:none}
    .gw-slide .gw-key i.gw-pos{background:var(--gw-pos)}
    .gw-slide .gw-key i.gw-dot{background:none;border-bottom:1.5px dotted var(--gw-muted);border-radius:0;width:12px;height:4px}
    .gw-slide .gw-ct td.gw-flag{color:var(--gw-neg);font-weight:600}
    .gw-slide .gw-ct td.gw-na{color:var(--gw-faint)}
    .gw-slide .gw-arr{display:flex;align-items:center;gap:8px}
    .gw-slide .gw-arr .gw-n{width:50px;text-align:right}
    .gw-slide .gw-arr .gw-bar{flex:1;height:8px;background:var(--gw-band);border-radius:2px;position:relative;max-width:66px}
    .gw-slide .gw-arr .gw-bar i{position:absolute;inset:0 auto 0 0;background:var(--gw-teal);border-radius:2px}
    .gw-slide .gw-arr .gw-p{width:30px;text-align:right;font-size:10.5px;color:var(--gw-muted);font-weight:400}
    .gw-slide .gw-ct tr.gw-tot .gw-arr .gw-bar i{background:var(--gw-navy)}
  </style>
</head>
<body>

  <!-- ============================================================
       SLIDE 1 — Section Cover
       ============================================================ -->
  <div class="slide section-cover">
    <div class="eyebrow">Section 03</div>
    <div class="section-title">ARR Walk</div>
    <div class="section-sub">Core, Lite &amp; Alanube · Countries Performance</div>
    <div class="slide-num">1</div>
  </div>

  <div class="slide-divider">↓</div>

  {# Oculta 2026-10-24: el usuario pidió volver a insertar el HTML estático ya validado
     ("board_3Q26_growth_slides_review.html", corregido y auditado esa sesión) tal cual,
     en vez de esta versión 100% atada a metrics.* — la versión en vivo de abajo quedaba
     con huecos reales (columnas LTM24-26, barras SVG decorativas, 2 de 3 tablas de la
     slide D) que no se resolvieron a tiempo. Código intacto abajo, reversible cambiando
     False por True — ver memory del proyecto para el plan de cómo cerrar esos huecos
     antes de volver a activarlo. #}
  {% if False %}
  <!-- ════════════════════════════════════════════════════════════════════
       GROWTH SLIDES (2026-10-23) — reemplazan visualmente las 3 slides de
       abajo (Combined View + Core/Lite individuales, ahora ocultas) por
       pedido del usuario. Diseño "board_3Q26_growth_slides_review.html"
       (validado y auditado esa sesión), re-implementado acá 100% atado a
       metrics.* — NO son números estáticos. Alcance real vs. el mockup
       original (documentado también en el reporte de esta tarea):
         · Slide A: igual a metrics.arr_walk_table (GLO), 7 trimestres
           (1Q25-3Q26). Las columnas LTM24/LTM25/LTM26 del mockup NO se
           implementaron — no existe ningún campo LTM en el pipeline (ni
           para 1 ni para los otros), habría que construirlo aparte.
           Retention: "Logo retention" SÍ se calcula en vivo (fórmula propia
           ya validada esta sesión); "Net ARR retention" se omitió porque
           ya se confirmó que no reconcilia con su propia fórmula y no hay
           otra fuente — mejor no mostrarla que mostrar un número no
           verificado.
         · Slide B: igual a metrics.arr_walk_products (Core/Lite), 5
           trimestres (3Q25-3Q26) — mismo motivo, sin columna LTM26.
         · Slide C/D: ARR/Logos/ARPA en vivo para el trimestre de corte
           (metrics.gw_country_summary, ver fetch_metrics.py). El histórico
           3Q24/3Q25 de ARR/Logos/ARPA por país reusa los mismos números
           estáticos ya vetados de la slide "ARR by Country — Version
           Comparison" de abajo (mismo hueco de pipeline ya documentado ahí:
           no existe un campo con serie trimestral histórica por país) — NO
           se re-derivó nada, es la misma fuente. Lo nuevo de verdad es el
           payback por país (slides C y D), 100% en vivo vía
           merge_country_payback() en fetch_metrics.py (expone
           metrics.country_payback y metrics.country_payback_hist — Jinja no
           puede llamar funciones de Python, por eso todo queda precalculado
           ahí, no invocado desde el template) — motor de cohortes real
           (bi_strategic.payback_cohort_results),
           mismo cache de Metabase que ya alimentaba payback_global/core/
           lite, sin query nueva. "Other" no tiene payback (el motor no
           modela esos países) — se muestra como "—", nunca inventado.
           Las columnas S&M/CAC/Churn por país y los sparklines de
           tendencia del mockup original NO se implementaron por falta de
           una fuente en vivo confiable dentro del tiempo de esta tarea —
           ver reporte para el detalle de qué haría falta construir.
       ════════════════════════════════════════════════════════════════════ -->
  {% set g_tbl   = metrics.arr_walk_table %}
  {% set g_logo  = g_tbl.sections | selectattr('label','equalto',"Logo EoP (000's)") | first %}
  {% set g_arr   = g_tbl.sections | selectattr('label','equalto',"ARR Walk — Spot ($M)") | first %}
  {% set g_saas  = g_tbl.sections | selectattr('label','equalto',"SaaS Metrics") | first %}
  {% set g_eop_row     = g_logo.rows | selectattr('label','equalto',"Total EoP") | first %}
  {% set g_newpct_row  = g_logo.rows | selectattr('label','equalto',"Logo Monthly New Adds %") | first %}
  {% set g_churnpct_row= g_logo.rows | selectattr('label','equalto',"Logo Monthly Churn %") | first %}
  {% set g_bop_row  = g_arr.rows | selectattr('label','equalto',"ARR BoP") | first %}
  {% set g_add_row  = g_arr.rows | selectattr('label','equalto',"Additions") | first %}
  {% set g_rec_row  = g_arr.rows | selectattr('label','equalto',"Recovered") | first %}
  {% set g_nc_row   = g_arr.rows | selectattr('label','equalto',"Net Churn") | first %}
  {% set g_ne_row   = g_arr.rows | selectattr('label','equalto',"Net Expansion") | first %}
  {% set g_fx_row   = g_arr.rows | selectattr('label','equalto',"(+/−) FX Impact") | first %}
  {% set g_arreop_row = g_arr.rows | selectattr('label','equalto',"ARR EoP") | first %}
  {% set g_arrcc_row  = g_arr.rows | selectattr('label','equalto',"ARR EoP (Constant Currency)") | first %}
  {% set g_sm_row   = g_saas.rows | selectattr('label','equalto',"S&M Total Spend") | first %}
  {% set g_pb_row   = g_saas.rows | selectattr('label','equalto',"CAC Payback (meses)") | first %}
  {% set g_arpa_row = g_saas.rows | selectattr('label','equalto',"ARPA") | first %}
  {% set g_arpaadd_row = g_saas.rows | selectattr('label','equalto',"ARPA Adds") | first %}
  {% set g_arpachn_row = g_saas.rows | selectattr('label','equalto',"ARPA Churn") | first %}
  {% set g_logo_retention = [] %}
  {% for v in g_churnpct_row.cells %}{% set _ = g_logo_retention.append(((1 - (v.replace('%','')|float/100)) ** 12 * 100) | round(0)) %}{% endfor %}

  <section class="slide gw-slide" style="width:960px;height:540px;border-radius:10px;overflow:hidden;display:flex;flex-direction:column;box-shadow:0 4px 24px rgba(0,0,0,.10),0 1px 4px rgba(0,0,0,.06);margin:0 auto;">
    <div class="gw-hd"><h2>ARR &amp; Logo Walk GLO Alegra · Quarterly</h2><span>{{ config.quarter_label if metrics.is_quarter_end else config.month_label }}</span></div>
    <div class="gw-body">
      <table class="gw-t" style="--gw-rh:17px">
        <colgroup><col class="gw-c-sec"><col style="width:142px"><col span="{{ g_tbl.quarters|length }}"></colgroup>
        <thead>
          <tr class="gw-seg"><th colspan="2"></th><th class="gw-sq" colspan="{{ g_tbl.quarters|length }}">Quarterly</th></tr>
          <tr class="gw-per"><th colspan="2"></th>{% for q in g_tbl.quarters %}<th{% if loop.last %} class="gw-cur"{% endif %}>{% if loop.last %}<span class="gw-pill">{{ q }}</span>{% else %}{{ q }}{% endif %}</th>{% endfor %}</tr>
        </thead>
        <tbody>
          <tr class="gw-lvl gw-first"><th class="gw-sec" rowspan="5">Logos<span>000s</span></th><td class="gw-m">Logos, EoP</td>{% for v in g_eop_row.cells %}<td class="gw-v gw-h{% if loop.last %} gw-cur{% endif %}">{{ v }}</td>{% endfor %}</tr>
          <tr><td class="gw-m">New adds<small>% / month</small></td>{% for v in g_newpct_row.cells %}<td class="gw-v gw-h{% if loop.last %} gw-cur{% endif %}">{{ v }}</td>{% endfor %}</tr>
          <tr><td class="gw-m">Churn<small>% / month</small></td>{% for v in g_churnpct_row.cells %}<td class="gw-v gw-h{% if loop.last %} gw-cur{% endif %}">{{ v }}</td>{% endfor %}</tr>
          <tr class="gw-sub"><td class="gw-m">Logo retention<small>LQA, (1−churn)^12</small></td>{% for v in g_logo_retention %}<td class="gw-v gw-h{% if loop.last %} gw-cur{% endif %}">{{ v|int }}%</td>{% endfor %}</tr>
          <tr class="gw-sub"><td class="gw-m">EoP YoY growth</td>{% for i in range(g_eop_row.cells|length) %}<td class="gw-v gw-h{% if loop.last %} gw-cur{% endif %}">{% if i >= 4 %}{{ ((g_eop_row.cells[i]|float / g_eop_row.cells[i-4]|float - 1) * 100) | round(0) | int }}%{% else %}—{% endif %}</td>{% endfor %}</tr>
          <tr class="gw-lvl gw-first"><th class="gw-sec" rowspan="9">ARR Walk<span>Spot, $M</span></th><td class="gw-m">ARR, BoP</td>{% for v in g_bop_row.cells %}<td class="gw-v gw-h{% if loop.last %} gw-cur{% endif %}">{{ v }}</td>{% endfor %}</tr>
          <tr><td class="gw-m"><b class="gw-op">+</b>Additions</td>{% for v in g_add_row.cells %}<td class="gw-v gw-h{% if loop.last %} gw-cur{% endif %}">{{ v }}</td>{% endfor %}</tr>
          <tr><td class="gw-m"><b class="gw-op">+</b>Recovered</td>{% for v in g_rec_row.cells %}<td class="gw-v gw-h{% if loop.last %} gw-cur{% endif %}">{{ v }}</td>{% endfor %}</tr>
          <tr><td class="gw-m"><b class="gw-op">−</b>Net Churn</td>{% for v in g_nc_row.cells %}<td class="gw-v gw-h gw-neg{% if loop.last %} gw-cur{% endif %}">{{ v }}</td>{% endfor %}</tr>
          <tr><td class="gw-m"><b class="gw-op">+</b>Net Expansion</td>{% for v in g_ne_row.cells %}<td class="gw-v gw-h{% if loop.last %} gw-cur{% endif %}">{{ v }}</td>{% endfor %}</tr>
          <tr><td class="gw-m"><b class="gw-op">±</b>FX Impact</td>{% for v in g_fx_row.cells %}<td class="gw-v gw-h{% if loop.last %} gw-cur{% endif %}">{{ v }}</td>{% endfor %}</tr>
          <tr class="gw-tot"><td class="gw-m">ARR, EoP</td>{% for v in g_arreop_row.cells %}<td class="gw-v gw-h{% if loop.last %} gw-cur{% endif %}">{{ v }}</td>{% endfor %}</tr>
          <tr class="gw-sub"><td class="gw-m">ARR, EoP<small>constant currency</small></td>{% for v in g_arrcc_row.cells %}<td class="gw-v gw-h{% if loop.last %} gw-cur{% endif %}">{{ v }}</td>{% endfor %}</tr>
          <tr class="gw-sub"><td class="gw-m">YoY growth<small>USD</small></td>{% for c in g_arreop_row.yoy_cells %}<td class="gw-v gw-h{% if loop.last %} gw-cur{% endif %}">{{ c.v }}</td>{% endfor %}</tr>
          <tr class="gw-lvl gw-first"><th class="gw-sec" rowspan="5">Unit economics</th><td class="gw-m">S&amp;M spend<small>$M</small></td>{% for v in g_sm_row.cells %}<td class="gw-v gw-h{% if loop.last %} gw-cur{% endif %}">{{ v }}</td>{% endfor %}</tr>
          <tr><td class="gw-m">CAC payback<small>months</small></td>{% for v in g_pb_row.cells %}<td class="gw-v gw-h{% if loop.last %} gw-cur{% endif %}">{{ v }}</td>{% endfor %}</tr>
          <tr><td class="gw-m">ARPA, all logos<small>$ / month</small></td>{% for v in g_arpa_row.cells %}<td class="gw-v gw-h{% if loop.last %} gw-cur{% endif %}">{{ v }}</td>{% endfor %}</tr>
          <tr><td class="gw-m">ARPA, new logos<small>$ / month</small></td>{% for v in g_arpaadd_row.cells %}<td class="gw-v gw-h{% if loop.last %} gw-cur{% endif %}">{{ v }}</td>{% endfor %}</tr>
          <tr><td class="gw-m">ARPA, churned logos<small>$ / month</small></td>{% for v in g_arpachn_row.cells %}<td class="gw-v gw-h{% if loop.last %} gw-cur{% endif %}">{{ v }}</td>{% endfor %}</tr>
        </tbody>
      </table>
    </div>
    <div class="gw-ft">
      <p>Logos in 000s; ARR at spot FX in $M; negatives in parentheses. <b>Nota:</b> columnas LTM y "Net ARR retention" del diseño original no están disponibles en el pipeline hoy — ver comentario en el código fuente de esta slide. Excludes Alanube. Source: dm_board ARR walk, live.</p>
      <div class="gw-key"><div><span><i></i>Negative / unfavorable</span><span><i class="sw"></i>Latest period</span></div><em>Alegra · Confidential</em></div>
    </div>
  </section>

  <div class="slide-divider">↓</div>

  <!-- GROWTH SLIDE B — Core vs Lite Quarterly Performance (ver nota arriba) -->
  {% set cp_core = metrics.arr_walk_products | selectattr('id','equalto','core') | first %}
  {% set cp_lite = metrics.arr_walk_products | selectattr('id','equalto','lite') | first %}
  {% if cp_core and cp_lite %}
  {% set cp_core_tbl = cp_core.arr_walk_table %}
  {% set cp_lite_tbl = cp_lite.arr_walk_table %}
  <section class="slide gw-slide" style="width:960px;height:540px;border-radius:10px;overflow:hidden;display:flex;flex-direction:column;box-shadow:0 4px 24px rgba(0,0,0,.10),0 1px 4px rgba(0,0,0,.06);margin:0 auto;">
    <div class="gw-hd"><h2>Core vs Lite Quarterly Performance GLO Alegra</h2><span>{{ config.quarter_label if metrics.is_quarter_end else config.month_label }}</span></div>
    <div class="gw-body">
      <div class="gw-ks gw-c3">
        <div class="gw-k"><div class="gw-k-top"><div class="gw-k-lbl"><i style="background:var(--gw-core)"></i>Core ARR</div></div><div class="gw-k-val">{{ cp_core.arr_eop }}</div><div class="gw-k-dl"><div><b>YoY</b><span>{{ cp_core.arr_yoy }}</span></div><div><b>QoQ</b><span>{{ cp_core.arr_qoq }}</span></div><div><b>Net new</b><span>{{ cp_core.net_new_arr }}</span></div></div></div>
        <div class="gw-k"><div class="gw-k-top"><div class="gw-k-lbl"><i style="background:var(--gw-lite)"></i>Lite ARR</div></div><div class="gw-k-val">{{ cp_lite.arr_eop }}</div><div class="gw-k-dl"><div><b>YoY</b><span>{{ cp_lite.arr_yoy }}</span></div><div><b>QoQ</b><span>{{ cp_lite.arr_qoq }}</span></div><div><b>Net new</b><span>{{ cp_lite.net_new_arr }}</span></div></div></div>
