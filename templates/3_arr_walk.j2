        </thead>
        <tbody><tr><td>Colombia</td><td>40.4k</td><td>42.5k</td><td>45.3k</td><td>+18.8%</td><td>+5.3%</td><td>+6.5%</td><td>$24.8</td><td>$30.7</td><td>$41.1</td><td>+21.0%</td><td>+24.0%</td><td>+33.6%</td></tr><tr><td>México</td><td>3.6k</td><td>4.3k</td><td>5.4k</td><td>+38.5%</td><td>+18.7%</td><td>+25.7%</td><td>$36.4</td><td>$44.6</td><td>$46.4</td><td>−8.4%</td><td>+22.6%</td><td>+3.9%</td></tr><tr><td>Rep. Dominicana</td><td>4.1k</td><td>4.1k</td><td>5.0k</td><td>+20.4%</td><td>+1.5%</td><td>+20.0%</td><td>$60.8</td><td>$82.0</td><td>$86.9</td><td>+6.8%</td><td>+34.9%</td><td>+6.1%</td></tr><tr><td>Costa Rica</td><td>1.0k</td><td>1.3k</td><td>1.7k</td><td>+50.4%</td><td>+26.3%</td><td>+29.8%</td><td>$45.4</td><td>$43.7</td><td>$47.7</td><td>−3.3%</td><td>−3.8%</td><td>+9.1%</td></tr><tr><td>Otros</td><td>3.2k</td><td>2.9k</td><td>3.4k</td><td>+25.0%</td><td>−9.0%</td><td>+18.3%</td><td>$34.5</td><td>$44.8</td><td>$46.9</td><td>+11.4%</td><td>+29.8%</td><td>+4.7%</td></tr><tr class="cv-total"><td>Total</td><td>52.2k</td><td>55.1k</td><td>60.7k</td><td>+21.0%</td><td>+5.5%</td><td>+10.2%</td><td>$29.4</td><td>$36.7</td><td>$45.8</td><td>+15.1%</td><td>+24.9%</td><td>+24.8%</td></tr></tbody>
