          {% set lite_sec = lite_tbl.sections | selectattr('label','equalto',sec.label) | first %}
          <tr class="aw-sh"><td>{{ sec.label }}</td><td colspan="{{ (n_q + 1) * 2 }}"></td></tr>
          {% for row in sec.rows %}
