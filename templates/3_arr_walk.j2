  {% set g_arpaadd_row = g_saas.rows | selectattr('label','equalto',"ARPA Adds") | first %}
  {% set g_arpachn_row = g_saas.rows | selectattr('label','equalto',"ARPA Churn") | first %}
<section class="slide gw-slide" aria-label="ARR and logo walk, quarterly and last twelve months, 3Q26">
  <header class="gw-hd"><h2>ARR &amp; Logo Walk GLO Alegra · Quarterly and LTM</h2><span>3Q26</span></header>
