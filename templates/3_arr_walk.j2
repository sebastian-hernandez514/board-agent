            <td class="awg-core-ytd">{{ row.ytd_cur }}</td>
            {% for c in lrow.cells %}<td class="awg-lite-actual">{{ c }}</td>{% endfor %}
            <td class="awg-lite-ytd">{{ lrow.ytd_cur }}</td>
